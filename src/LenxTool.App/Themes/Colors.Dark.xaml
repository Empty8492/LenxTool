<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Color.Window">#151816</Color>
    <Color x:Key="Color.Surface">#1C201D</Color>
    <Color x:Key="Color.SurfaceRaised">#242925</Color>
    <Color x:Key="Color.SurfaceMuted">#2A302B</Color>
    <Color x:Key="Color.Sidebar">#111311</Color>
    <Color x:Key="Color.SidebarRaised">#222622</Color>
    <Color x:Key="Color.TextPrimary">#F1EEE7</Color>
    <Color x:Key="Color.TextSecondary">#A9AFA7</Color>
    <Color x:Key="Color.TextOnDark">#F5F2EB</Color>
    <Color x:Key="Color.TextOnDarkMuted">#A7ADA5</Color>
    <Color x:Key="Color.Border">#373D38</Color>
    <Color x:Key="Color.BorderStrong">#505750</Color>
    <Color x:Key="Color.Accent">#D57952</Color>
    <Color x:Key="Color.AccentSoft">#4A3027</Color>
    <Color x:Key="Color.Success">#6EAE91</Color>
    <Color x:Key="Color.Warning">#D2A45D</Color>
    <Color x:Key="Color.Error">#E07A70</Color>
    <Color x:Key="Color.Focus">#E18A63</Color>

    <SolidColorBrush x:Key="Brush.Window" Color="{DynamicResource Color.Window}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{DynamicResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceRaised" Color="{DynamicResource Color.SurfaceRaised}" />
    <SolidColorBrush x:Key="Brush.SurfaceMuted" Color="{DynamicResource Color.SurfaceMuted}" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="{DynamicResource Color.Sidebar}" />
    <SolidColorBrush x:Key="Brush.SidebarRaised" Color="{DynamicResource Color.SidebarRaised}" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{DynamicResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{DynamicResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextOnDark" Color="{DynamicResource Color.TextOnDark}" />
    <SolidColorBrush x:Key="Brush.TextOnDarkMuted" Color="{DynamicResource Color.TextOnDarkMuted}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{DynamicResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="{DynamicResource Color.BorderStrong}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{DynamicResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="{DynamicResource Color.AccentSoft}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{DynamicResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{DynamicResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.Error" Color="{DynamicResource Color.Error}" />
    <SolidColorBrush x:Key="Brush.Focus" Color="{DynamicResource Color.Focus}" />
</ResourceDictionary>
