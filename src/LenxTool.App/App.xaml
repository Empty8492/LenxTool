                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,24,0">
                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="应用更新" />
                                    <TextBlock Margin="0,8,0,0" Style="{StaticResource MetaTextStyle}" Text="{Binding UpdateStatus}" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,8,0,0" Style="{StaticResource MetaTextStyle}" Text="{Binding ReleaseNotes}" TextWrapping="Wrap" />
                                    <ProgressBar Height="3" Margin="0,12,0,0" Maximum="100" Value="{Binding UpdateProgress, Mode=OneWay}" />
