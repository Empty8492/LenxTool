                                                    <DataTrigger Binding="{Binding TrendGroups.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock HorizontalAlignment="Center" Style="{StaticResource SectionTitleStyle}" Text="未选择热点来源" />
                                            <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" Style="{StaticResource MetaTextStyle}" Text="重新勾选来源，或点击“全选”恢复全部平台。" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </TabItem>
