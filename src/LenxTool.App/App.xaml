                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Margin="0,0,8,0" Command="{Binding CheckForUpdatesCommand}" Content="检查更新" />
                                    <Button Style="{StaticResource AccentButtonStyle}" Command="{Binding DownloadUpdateCommand}" Content="下载并安装" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ToolsViewModel}">
                <Grid Margin="32,28,32,32">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitleStyle}" Text="{Binding Title}" />
                        <TextBlock Margin="0,7,0,0" Style="{StaticResource MetaTextStyle}" Text="{Binding Subtitle}" />
                    </StackPanel>
                    <WrapPanel Grid.Row="2">
                        <Button Margin="0,0,8,8" Command="{Binding FormatJsonCommand}" Content="格式化 JSON" />
                        <Button Margin="0,0,8,8" Command="{Binding MinifyJsonCommand}" Content="压缩" />
                        <Button Margin="0,0,8,8" Command="{Binding SortJsonCommand}" Content="键排序" />
                        <Button Margin="0,0,8,8" Command="{Binding ValidateJsonCommand}" Content="校验" />
                        <Button Margin="0,0,8,8" Command="{Binding EncodeBase64Command}" Content="Base64 编码" />
                        <Button Margin="0,0,8,8" Command="{Binding DecodeBase64Command}" Content="Base64 解码" />
                        <Button Margin="0,0,8,8" Command="{Binding EncodeUrlCommand}" Content="URL 编码" />
                        <Button Margin="0,0,8,8" Command="{Binding DecodeUrlCommand}" Content="URL 解码" />
                        <Button Margin="0,0,8,8" Command="{Binding CleanTextCommand}" Content="清理文本" />
                        <Button Margin="0,0,8,8" Command="{Binding HashFileCommand}" Content="SHA-256 文件校验" />
                        <Button Margin="0,0,8,8" Command="{Binding WordToPdfCommand}" Content="Word 转 PDF" />
                    </WrapPanel>
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="52" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource BentoCardStyle}" Padding="0">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <TextBlock Margin="16,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="输入" />
                                <TextBox Grid.Row="1" Padding="16" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button Width="38" Height="38" Padding="8" Command="{Binding SwapCommand}" ToolTip="交换输入与输出">
                                <Path Stretch="Uniform" Stroke="{DynamicResource Brush.Accent}" StrokeThickness="1.6" Data="M4,8 L18,8 15,5 M18,8 15,11 M20,16 L6,16 9,13 M6,16 9,19" />
                            </Button>
                        </StackPanel>
                        <Border Grid.Column="2" Style="{StaticResource BentoCardStyle}" Padding="0">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="*" /><RowDefinition Height="34" /></Grid.RowDefinitions>
                                <TextBlock Margin="16,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="结果" />
                                <TextBox Grid.Row="1" Padding="16" AcceptsReturn="True" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" Text="{Binding Output}" />
                                <TextBlock Grid.Row="2" Margin="16,0" VerticalAlignment="Center" Style="{StaticResource MetaTextStyle}" Text="{Binding Status}" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:NewsCenterViewModel}">
                <Grid>
                    <!-- 滚轮灵敏度与缓动由全局 ScrollViewer 类处理，此处只保留早报页的回顶能力。 -->
                    <controls:AnimatedScrollViewer x:Name="NewsPageScrollViewer"
                                                   VerticalScrollBarVisibility="Visible"
                                                   HorizontalScrollBarVisibility="Disabled"
                                                   PanningMode="VerticalOnly"
                                                   IsDeferredScrollingEnabled="False"
                                                   ScrollResetKey="{Binding SelectedSectionIndex}">
                <Grid Margin="28,10,28,28">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="6" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <DockPanel LastChildFill="False">
                        <StackPanel><TextBlock Style="{StaticResource PageTitleStyle}" Text="{Binding ActiveSectionTitle}" /><TextBlock Margin="0,6,0,0" Style="{StaticResource MetaTextStyle}" Text="{Binding Status}" /></StackPanel>
                        <Button DockPanel.Dock="Right"
                                MinWidth="116"
                                VerticalAlignment="Center"
                                Style="{StaticResource AccentButtonStyle}"
                                Command="{Binding RefreshCommand}"
                                AutomationProperties.Name="刷新今日资讯"
                                Content="刷新今日资讯" />
                    </DockPanel>
                    <TabControl Grid.Row="2"
                                MinHeight="620"
                                Background="Transparent"
                                BorderThickness="0"
                                SelectedIndex="{Binding SelectedSectionIndex, Mode=TwoWay}">
                        <TabControl.Template>
                            <ControlTemplate TargetType="TabControl">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </ControlTemplate>
                        </TabControl.Template>
                        <TabItem Header="资讯列表">
                            <views:FeedTimelineView />
                        </TabItem>
                        <TabItem Header="每日早报">
                            <Border Margin="0,8,0,0" Style="{StaticResource BentoCardStyle}" Padding="0" ClipToBounds="True">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="56" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid Margin="22,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="早报阅读" />
                                            <TextBlock Margin="0,4,0,0" Style="{StaticResource MetaTextStyle}" Text="默认显示今天；可选择已有日期查看历史早报" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Margin="0,0,16,0"
                                                    Command="{Binding GenerateArticleReportCommand}"
                                                    AutomationProperties.Name="为当前早报生成 AI 解读"
                                                    Content="生成 AI 解读" />
                                            <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" Style="{StaticResource MetaTextStyle}" Text="选择日期" />
                                             <ComboBox Width="150"
                                                       MinHeight="36"
                                                       Style="{StaticResource CompactComboBoxStyle}"
                                                       ItemsSource="{Binding ArticleDates}"
                                                       SelectedItem="{Binding SelectedDate}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate><TextBlock Text="{Binding StringFormat={}{0:yyyy-MM-dd}}" /></DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                    <controls:RichArticleView Grid.Row="1" Article="{Binding SelectedArticle}" />
                                </Grid>
                            </Border>
                        </TabItem>
                        <TabItem Header="热点趋势">
                            <Grid Margin="0,8,0,0">
                                <Grid.Resources>
                                    <!-- 每个平台卡片只在进入有效视口缓冲区后创建其 10 个按钮。 -->
                                    <DataTemplate x:Key="TrendPlatformCardTemplate">
                                        <Border Margin="0,0,12,12"
                                                Padding="0"
                                                Style="{StaticResource BentoCardStyle}"
                                                ClipToBounds="True">
                                            <Grid>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                <Grid Margin="18,14">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Platform}" />
                                                    <TextBlock Grid.Column="1" Style="{StaticResource MetaTextStyle}" Text="{Binding Count, StringFormat={}{0} 条}" />
                                                </Grid>
                                                <ItemsControl Grid.Row="1" ItemsSource="{Binding Items}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Style="{StaticResource TrendItemButtonStyle}"
                                                                    Command="{Binding DataContext.OpenTrendCommand, RelativeSource={RelativeSource AncestorType={x:Type TabControl}}}"
                                                                    CommandParameter="{Binding}"
                                                                    AutomationProperties.Name="{Binding Title}">
                                                                <Grid Margin="16,12">
                                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="18" /></Grid.ColumnDefinitions>
                                                                    <TextBlock VerticalAlignment="Top" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}" Text="{Binding Rank}" />
                                                                    <TextBlock Grid.Column="1" Margin="0,0,14,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" />
                                                                    <TextBlock Grid.Column="2" Margin="0,0,10,0" VerticalAlignment="Center" Style="{StaticResource MetaTextStyle}" Text="{Binding Heat}" />
                                                                    <Path Grid.Column="3" Width="7" Height="11" VerticalAlignment="Center" Stretch="Fill" Stroke="{DynamicResource Brush.TextMuted}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 1,1 L 6,5.5 L 1,10" />
                                                                </Grid>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </Grid.Resources>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Border Padding="20,14" Style="{StaticResource BentoCardStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="1" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
