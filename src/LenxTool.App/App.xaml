                                                    <DataTemplate>
                                                        <ToggleButton Style="{StaticResource FilterChipStyle}"
                                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                      AutomationProperties.Name="{Binding Platform, StringFormat=来源筛选：{0}}">
