                                                          ItemsSource="{Binding FullTextPolicyChoices}"
                                                          DisplayMemberPath="Label"
                                                          SelectedItem="{Binding SelectedFullTextPolicy}" />

                                                <Border Margin="0,18,0,0"
                                                        Padding="14"
                                                        Background="{DynamicResource Brush.SurfaceMuted}"
                                                        CornerRadius="8">
                                                    <StackPanel>
                                                        <TextBlock FontWeight="SemiBold" Text="AI 处理策略" />
                                                        <TextBlock Margin="0,4,0,12"
                                                                   Style="{StaticResource MetaTextStyle}"
                                                                   Text="Feed 覆盖优先于分类；留空或继承时继续使用上级设置。"
                                                                   TextWrapping="Wrap" />
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="10" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="10" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Margin="0,0,0,6" Style="{StaticResource MetaTextStyle}" Text="手动摘要" />
                                                                <ComboBox AutomationProperties.Name="Feed 手动摘要策略"
                                                                          ItemsSource="{Binding AiPolicySwitchChoices}"
                                                                          DisplayMemberPath="Label"
                                                                          SelectedValuePath="Policy"
                                                                          SelectedValue="{Binding FeedManualSummaryPolicy}" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2">
                                                                <TextBlock Margin="0,0,0,6" Style="{StaticResource MetaTextStyle}" Text="自动摘要" />
                                                                <ComboBox AutomationProperties.Name="Feed 自动摘要策略"
                                                                          ItemsSource="{Binding AiPolicySwitchChoices}"
                                                                          DisplayMemberPath="Label"
                                                                          SelectedValuePath="Policy"
                                                                          SelectedValue="{Binding FeedAutoSummaryPolicy}" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="4">
                                                                <TextBlock Margin="0,0,0,6" Style="{StaticResource MetaTextStyle}" Text="自动翻译" />
                                                                <ComboBox AutomationProperties.Name="Feed 自动翻译策略"
                                                                          ItemsSource="{Binding AiPolicySwitchChoices}"
                                                                          DisplayMemberPath="Label"
                                                                          SelectedValuePath="Policy"
                                                                          SelectedValue="{Binding FeedAutoTranslationPolicy}" />
                                                            </StackPanel>
                                                        </Grid>
                                                        <Grid Margin="0,12,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="10" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="10" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Margin="0,0,0,6" Style="{StaticResource MetaTextStyle}" Text="翻译语言" />
                                                                <ComboBox AutomationProperties.Name="Feed 翻译目标语言"
                                                                          ItemsSource="{Binding AiLanguageChoices}"
                                                                          DisplayMemberPath="Label"
                                                                          SelectedValuePath="Language"
                                                                          SelectedValue="{Binding FeedTranslationTargetLanguage}" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2">
                                                                <TextBlock Margin="0,0,0,6" Style="{StaticResource MetaTextStyle}" Text="每日条目（1～1000）" />
                                                                <TextBox AutomationProperties.Name="Feed 每日 AI 条目上限"
                                                                         Text="{Binding FeedAiDailyEntryLimit, UpdateSourceTrigger=PropertyChanged}" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="4">
                                                                <TextBlock Margin="0,0,0,6" Style="{StaticResource MetaTextStyle}" Text="并发（1～4）" />
                                                                <TextBox AutomationProperties.Name="Feed AI 并发上限"
                                                                         Text="{Binding FeedAiMaxConcurrency, UpdateSourceTrigger=PropertyChanged}" />
                                                                </StackPanel>
                                                            </Grid>
                                                        <TextBlock Margin="0,12,0,0"
                                                                   AutomationProperties.Name="Feed AI 用量预估"
                                                                   Foreground="{DynamicResource Brush.Accent}"
                                                                   FontWeight="SemiBold"
                                                                   Text="{Binding FeedAiUsageEstimate}"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>

                                                <CheckBox Margin="0,14,0,0"
                                                          Foreground="{DynamicResource Brush.TextPrimary}"
                                                          IsChecked="{Binding FeedIsEnabled}"
                                                          Content="允许普通用户同步此 Feed" />
                                                <Button Margin="0,18,0,0"
                                                        HorizontalAlignment="Left"
                                                        Style="{StaticResource AccentButtonStyle}"
                                                        AutomationProperties.Name="保存共享 Feed"
                                                        Command="{Binding SaveFeedCommand}"
                                                        Content="保存 Feed" />

                                                <Border Margin="0,18,0,0"
                                                        Padding="12"
                                                        Background="{DynamicResource Brush.SurfaceMuted}"
                                                        CornerRadius="8"
                                                        Visibility="{Binding IsFeedDeletePending, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <StackPanel>
                                                        <TextBlock FontWeight="SemiBold" Text="确认删除 Feed？" />
                                                        <TextBlock Margin="0,5,0,10"
                                                                   Style="{StaticResource MetaTextStyle}"
                                                                   Text="只删除共享目录项，已缓存文章继续保留。"
                                                                   TextWrapping="Wrap" />
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Margin="0,0,8,0"
                                                                    AutomationProperties.Name="取消删除 Feed"
                                                                    Command="{Binding CancelDeleteFeedCommand}"
                                                                    Content="取消" />
                                                            <Button AutomationProperties.Name="确认删除 Feed"
                                                                    Command="{Binding ConfirmDeleteFeedCommand}"
                                                                    Content="确认删除" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </TabItem>

                            <TabItem Header="健康">
                                <views:FeedHealthView />
                            </TabItem>

                            <TabItem Header="OPML 导入/导出">
                                <Grid Margin="0,16,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="14" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Border Style="{StaticResource BentoCardStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="先预览，再原子导入" />
                                                <TextBlock Margin="0,7,0,0"
                                                           MaxWidth="620"
                                                           Style="{StaticResource MetaTextStyle}"
                                                           Text="最多读取 2 MiB OPML；禁用 DTD/外部实体。嵌套分组展平为“父 / 子”分类，重复、冲突和无效项默认不可选。"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Margin="0,12,0,0"
                                                           AutomationProperties.Name="OPML 预览摘要"
                                                           AutomationProperties.LiveSetting="Polite"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding OpmlSummary}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <WrapPanel Grid.Column="1"
                                                       Margin="20,0,0,0"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Top">
                                                <Button Margin="0,0,8,8"
                                                        AutomationProperties.Name="选择并预览 OPML"
                                                        Command="{Binding PreviewOpmlCommand}"
                                                        Content="选择并预览" />
                                                <Button Margin="0,0,8,8"
                                                        AutomationProperties.Name="导出共享目录 OPML"
                                                        Command="{Binding ExportOpmlCommand}"
                                                        Content="导出目录" />
                                                <Button Margin="0,0,0,8"
                                                        Style="{StaticResource AccentButtonStyle}"
                                                        AutomationProperties.Name="原子导入已选 OPML 项"
                                                        Command="{Binding ImportSelectedOpmlCommand}"
                                                        Content="验证并原子导入" />
                                            </WrapPanel>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Row="2" Style="{StaticResource BentoCardStyle}" Padding="0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="52" />
                                                <RowDefinition Height="420" />
                                            </Grid.RowDefinitions>
                                            <DockPanel Margin="16,0">
                                                <TextBlock VerticalAlignment="Center"
                                                           Style="{StaticResource SectionTitleStyle}"
                                                           Text="导入预览" />
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                    <Button Margin="0,0,8,0"
                                                            Padding="10,5"
                                                            AutomationProperties.Name="选择所有 OPML 新增项"
                                                            Command="{Binding SelectAllNewOpmlCommand}"
                                                            Content="全选新增" />
                                                    <Button Padding="10,5"
                                                            AutomationProperties.Name="清除 OPML 选择"
                                                            Command="{Binding ClearOpmlSelectionCommand}"
                                                            Content="清除选择" />
                                                </StackPanel>
                                            </DockPanel>
                                            <ListView Grid.Row="1"
                                                      AutomationProperties.Name="OPML 导入预览列表"
                                                      ItemsSource="{Binding OpmlItems}"
                                                      Background="Transparent"
                                                      BorderThickness="0"
                                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                <ListView.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="10,8" MinWidth="590">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="34" />
                                                                <ColumnDefinition Width="2*" />
                                                                <ColumnDefinition Width="120" />
                                                                <ColumnDefinition Width="90" />
                                                                <ColumnDefinition Width="2*" />
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox VerticalAlignment="Center"
                                                                      AutomationProperties.Name="选择此 OPML 项"
                                                                      IsEnabled="{Binding IsSelectable}"
                                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                                            <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                                                <TextBlock FontWeight="SemiBold"
                                                                           Text="{Binding Title}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Margin="0,4,0,0"
                                                                           Style="{StaticResource MetaTextStyle}"
                                                                           Text="{Binding FeedUrl}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2"
                                                                       Margin="0,0,14,0"
                                                                       VerticalAlignment="Center"
                                                                       Style="{StaticResource MetaTextStyle}"
                                                                       Text="{Binding CategoryName, TargetNullValue=未分类}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="3"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource Brush.Accent}"
                                                                       FontWeight="SemiBold"
                                                                       Text="{Binding StatusLabel}" />
                                                            <TextBlock Grid.Column="4"
                                                                       VerticalAlignment="Center"
                                                                       Style="{StaticResource MetaTextStyle}"
                                                                       Text="{Binding Message}"
                                                                       TextWrapping="Wrap" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </ScrollViewer>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:WorkspacePageViewModel}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="32,28,32,40">
                        <DockPanel LastChildFill="False">
                            <StackPanel>
                                <TextBlock Style="{StaticResource PageTitleStyle}" Text="{Binding Title}" />
                                <TextBlock Margin="0,7,0,0" Style="{StaticResource MetaTextStyle}" Text="{Binding Subtitle}" />
                            </StackPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource AccentButtonStyle}" Content="{Binding PrimaryAction}" />
                        </DockPanel>
                        <ItemsControl Margin="0,24,0,0" ItemsSource="{Binding Features}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="330" MinHeight="176" Margin="0,0,16,16" Style="{StaticResource BentoCardStyle}">
                                        <StackPanel>
                                            <DockPanel><TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}" Text="{Binding Kicker}" /><TextBlock DockPanel.Dock="Right" Style="{StaticResource MetaTextStyle}" Text="{Binding Status}" /></DockPanel>
                                            <TextBlock Margin="0,22,0,7" FontSize="18" FontWeight="SemiBold" Text="{Binding Title}" />
                                            <TextBlock Style="{StaticResource MetaTextStyle}" Text="{Binding Description}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="32,28,32,40">
                        <TextBlock Style="{StaticResource PageTitleStyle}" Text="{Binding Title}" />
                        <TextBlock Margin="0,7,0,24" Style="{StaticResource MetaTextStyle}" Text="{Binding Subtitle}" />
                        <Border Style="{StaticResource BentoCardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="外观与动效" />
                                <CheckBox Margin="0,18,0,0" Foreground="{DynamicResource Brush.TextPrimary}" Content="使用深色模式" IsChecked="{Binding IsDarkMode}" />
                                <CheckBox Margin="0,12,0,0" Foreground="{DynamicResource Brush.TextPrimary}" Content="减少动画（仅保留必要状态反馈）" IsChecked="{Binding ReduceMotion}" />
                                <DockPanel Margin="0,16,0,0" LastChildFill="False">
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource MetaTextStyle}" Text="{Binding AppearanceStatus}" />
                                    <Button DockPanel.Dock="Right" Margin="16,0,0,0" Command="{Binding SaveAppearanceCommand}" Content="保存外观" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <Border Margin="0,16,0,0" Style="{StaticResource BentoCardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="共享账号" />
                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource MetaTextStyle}"
                                           Text="{Binding AccountStatus}"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,6,0,0"
                                           AutomationProperties.Name="共享目录同步状态"
                                           Style="{StaticResource MetaTextStyle}"
                                           Text="{Binding CatalogSyncStatus}"
                                           TextWrapping="Wrap" />
                                <Grid Margin="0,16,0,0"
                                      Visibility="{Binding IsSignedOut, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource MetaTextStyle}" Text="用户名" />
                                        <TextBox Margin="0,7,0,0"
                                                 Padding="10,7"
                                                 AutomationProperties.Name="共享账号用户名"
                                                 Text="{Binding AccountUsernameInput, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource MetaTextStyle}" Text="密码" />
                                        <PasswordBox Margin="0,7,0,0"
                                                     Padding="10,7"
                                                     AutomationProperties.Name="共享账号密码"
                                                     controls:PasswordBoxAssistant.BoundPassword="{Binding AccountPasswordInput, Mode=TwoWay}" />
                                    </StackPanel>
                                    <Button Grid.Column="4"
                                            MinWidth="96"
                                            VerticalAlignment="Bottom"
                                            IsDefault="True"
                                            Style="{StaticResource AccentButtonStyle}"
                                            AutomationProperties.Name="登录共享账号"
                                            Command="{Binding LoginCommand}"
                                            Content="登录" />
                                </Grid>
                                <Grid Margin="0,16,0,0"
                                      Visibility="{Binding IsSignedIn, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="{Binding AccountIdentity}" />
                                        <TextBlock Margin="0,6,0,0"
                                                   Style="{StaticResource MetaTextStyle}"
                                                   Text="{Binding AccountQuotaSummary}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                                        <Button Margin="0,0,8,0"
                                                AutomationProperties.Name="刷新账号额度"
                                                Command="{Binding RefreshAccountCommand}"
                                                Content="刷新额度" />
                                        <Button AutomationProperties.Name="退出共享账号"
                                                Command="{Binding LogoutCommand}"
                                                Content="退出" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Margin="0,16,0,0" Style="{StaticResource BentoCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="自备 Groq Key" />
                                    <PasswordBox Margin="0,10,0,0" Padding="10,7" controls:PasswordBoxAssistant.BoundPassword="{Binding GroqKeyInput, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="自备 DeepSeek Key" />
                                    <PasswordBox Margin="0,10,0,0" Padding="10,7" controls:PasswordBoxAssistant.BoundPassword="{Binding DeepSeekKeyInput, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" Margin="16,0,0,0" VerticalAlignment="Bottom" Orientation="Horizontal">
                                    <Button Margin="0,0,8,0" Command="{Binding DeleteSecretsCommand}" Content="清除" />
                                    <Button Style="{StaticResource AccentButtonStyle}" Command="{Binding SaveSecretsCommand}" Content="加密保存" />
                                </StackPanel>
                                <TextBlock Grid.ColumnSpan="3" Margin="0,72,0,0" Style="{StaticResource MetaTextStyle}" Text="{Binding SecretStatus}" />
                            </Grid>
                        </Border>
                        <Border Margin="0,16,0,0"
                                DataContext="{Binding IntegrationSettings}"
