                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}" Text="DEEPSEEK" />
                                            <TextBlock Margin="0,4,0,0" HorizontalAlignment="Right" Style="{StaticResource MetaTextStyle}" Text="输出按纯文本保存 · 可取消" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="340" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource BentoCardStyle}" Padding="0">
                                        <ListBox ItemsSource="{Binding Reports}"
                                                 SelectedItem="{Binding SelectedReport}"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 AutomationProperties.Name="AI 报告列表">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="18,14" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
                                                        <StackPanel>
                                                            <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" />
                                                            <DockPanel Margin="0,7,0,0">
                                                                <TextBlock Style="{StaticResource MetaTextStyle}" Text="{Binding Model}" />
                                                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource MetaTextStyle}" Text="{Binding TokenUsage, StringFormat={}{0} tokens}" />
                                                            </DockPanel>
                                                            <TextBlock Margin="0,5,0,0" Style="{StaticResource MetaTextStyle}" Text="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource BentoCardStyle}" Padding="0">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="56" /><RowDefinition Height="*" /><RowDefinition Height="40" /></Grid.RowDefinitions>
                                            <StackPanel Margin="22,0" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{Binding SelectedReport.Title, TargetNullValue=尚未生成报告}" TextWrapping="Wrap" />
                                                <TextBlock Margin="0,4,0,0" Style="{StaticResource MetaTextStyle}" Text="{Binding SelectedReport.Model, TargetNullValue=请从每日早报或热点趋势页生成第一份报告}" />
                                            </StackPanel>
                                            <TextBox Grid.Row="1"
                                                     Padding="22,16"
                                                     IsReadOnly="True"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     VerticalScrollBarVisibility="Auto"
                                                     BorderThickness="0,1,0,1"
                                                     BorderBrush="{DynamicResource Brush.Border}"
                                                     Background="Transparent"
                                                     AutomationProperties.Name="AI 报告正文"
                                                     Text="{Binding SelectedReport.Content, Mode=OneWay}" />
                                            <TextBlock Grid.Row="2" Margin="22,0" VerticalAlignment="Center" Style="{StaticResource MetaTextStyle}" Text="AI 输出可能存在错误，请结合原始资讯核验；报告与用量仅保存在本地 SQLite。" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
                    </controls:AnimatedScrollViewer>
                    <Button Width="44"
                            Height="44"
                            Margin="0,0,32,28"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Panel.ZIndex="10"
                            Command="{x:Static controls:AnimatedScrollViewer.SmoothScrollToTopCommand}"
                            CommandTarget="{Binding ElementName=NewsPageScrollViewer}"
                            AutomationProperties.Name="回到页面顶部"
                            ToolTip="回到顶部">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FloatingActionButtonStyle}">
                                <Setter Property="Opacity" Value="0" />
                                <Setter Property="IsHitTestVisible" Value="False" />
                                <Setter Property="RenderTransform"><Setter.Value><TranslateTransform Y="8" /></Setter.Value></Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBackToTopVisible, ElementName=NewsPageScrollViewer}" Value="True">
                                        <Setter Property="IsHitTestVisible" Value="True" />
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.28" />
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.28" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="8" Duration="0:0:0.18" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Path Width="14"
                              Height="14"
                              Stretch="Uniform"
                              Stroke="White"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M 2,8 L 7,3 L 12,8 M 7,3 L 7,13" />
                    </Button>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
