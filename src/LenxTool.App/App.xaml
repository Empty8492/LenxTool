<Application x:Class="LenxTool.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LenxTool.App.Controls"
             xmlns:vm="clr-namespace:LenxTool.App.ViewModels"
             xmlns:views="clr-namespace:LenxTool.App.Views"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.Light.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
                <ResourceDictionary Source="Themes/DateControls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 列表继续使用虚拟化，但改为像素单位，才能获得连续滚动而不是整项跳动。 -->
            <Style x:Key="PixelVirtualizedListStyle" TargetType="{x:Type ListBox}">
                <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
                <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
                <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
                <!-- 前后各保留一屏容器，连续滚轮可一次提交目标偏移后由合成器补间。 -->
                <Setter Property="VirtualizingPanel.CacheLength" Value="1,1" />
                <Setter Property="VirtualizingPanel.CacheLengthUnit" Value="Page" />
            </Style>
            <Style TargetType="{x:Type ListBox}"
                   BasedOn="{StaticResource PixelVirtualizedListStyle}" />
            <Style TargetType="{x:Type ListView}"
                   BasedOn="{StaticResource PixelVirtualizedListStyle}" />
            <Style TargetType="{x:Type controls:PagedListBox}"
                   BasedOn="{StaticResource PixelVirtualizedListStyle}" />
            <Style TargetType="{x:Type ComboBox}">
                <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
                <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
                <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
                <Setter Property="VirtualizingPanel.CacheLength" Value="1,1" />
                <Setter Property="VirtualizingPanel.CacheLengthUnit" Value="Page" />
            </Style>

            <DataTemplate DataType="{x:Type vm:AutomationAdminViewModel}">
                <views:AutomationAdminView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:SmartViewAdminViewModel}">
                <views:SmartViewAdminView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:IntegrationAdminViewModel}">
                <views:IntegrationAdminView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <Grid Margin="32,28,32,40">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="22" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource PageTitleStyle}" Text="{Binding Title}" />
                            <TextBlock Margin="0,7,0,0" Style="{StaticResource MetaTextStyle}" Text="{Binding Subtitle}" />
                            <TextBlock Margin="0,4,0,0"
                                       Style="{StaticResource MetaTextStyle}"
                                       Text="{Binding DataStatus}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.55*" MinWidth="390" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" MinWidth="280" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource BentoCardStyle}">
                                <StackPanel>
                                    <ItemsControl Margin="0,0,0,2" ItemsSource="{Binding BriefingSections}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,13">
                                                    <TextBlock FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding Title}" />
                                                    <ItemsControl Margin="0,5,0,0" ItemsSource="{Binding Items}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,0,0,5">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="14" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Foreground="{DynamicResource Brush.Accent}" Text="•" />
                                                                    <TextBlock Grid.Column="1"
                                                                               FontSize="13"
                                                                               Foreground="{DynamicResource Brush.TextSecondary}"
                                                                               Text="{Binding}"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               ToolTip="{Binding}" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Margin="0,3,0,14"
                                               Style="{StaticResource MetaTextStyle}"
                                               Text="{Binding BriefingEmptyText}"
                                               TextWrapping="Wrap" />
                                    <Button HorizontalAlignment="Left"
                                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="daily-briefing"
                                            Content="查看完整早报" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2"
                                    Style="{StaticResource BentoCardStyle}"
                                    Background="{DynamicResource Brush.SurfaceMuted}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="热点脉搏" />
                                    <TextBlock Margin="0,5,0,16"
                                               FontSize="12"
                                               Foreground="{DynamicResource Brush.TextSecondary}"
                                               Text="{Binding TrendStatus}" />
                                    <ItemsControl ItemsSource="{Binding Trends}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,15">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}" Text="{Binding Rank}" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Foreground="{DynamicResource Brush.TextPrimary}" Text="{Binding Title}" />
                                                        <TextBlock Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" Text="{Binding Platform}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" Text="{Binding Heat}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="1.3*" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource BentoCardStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="最近任务" />
                                    <ItemsControl Margin="0,14,0,0" ItemsSource="{Binding RecentTasks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,14">
                                                    <DockPanel><TextBlock FontWeight="SemiBold" Text="{Binding Name}" /><TextBlock DockPanel.Dock="Right" Style="{StaticResource MetaTextStyle}" Text="{Binding Status}" /></DockPanel>
                                                    <ProgressBar Height="3" Margin="0,8,0,6" Maximum="100" Value="{Binding Progress, Mode=OneWay}" />
                                                    <TextBlock Style="{StaticResource MetaTextStyle}" Text="{Binding Detail}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource BentoCardStyle}" Background="{DynamicResource Brush.SurfaceMuted}">
                                <StackPanel>
                                    <DockPanel LastChildFill="False">
                                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="快捷开始" />
                                        <TextBlock DockPanel.Dock="Right"
                                                   Style="{StaticResource MetaTextStyle}"
                                                   Text="{Binding FavoriteSummary}" />
                                    </DockPanel>
                                    <ItemsControl Margin="0,14,0,0" ItemsSource="{Binding QuickActions}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Margin="0,0,10,0" Padding="14" HorizontalContentAlignment="Left"
                                                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding PageId}">
                                                    <StackPanel>
                                                        <Path Width="22" Height="22" Stretch="Uniform" Stroke="{DynamicResource Brush.Accent}" StrokeThickness="1.7" Data="{Binding IconData}" />
                                                        <TextBlock Margin="0,14,0,3" FontWeight="SemiBold" Text="{Binding Label}" />
                                                        <TextBlock Style="{StaticResource MetaTextStyle}" Text="{Binding Description}" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:MediaWorkbenchViewModel}">
                <Grid Margin="28,24,28,28">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel LastChildFill="False">
                        <StackPanel>
                            <TextBlock Style="{StaticResource PageTitleStyle}" Text="{Binding Title}" />
                            <TextBlock Margin="0,7,0,0" Style="{StaticResource MetaTextStyle}" Text="{Binding Subtitle}" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Margin="0,0,8,0" Command="{Binding ImportModelCommand}" Content="导入模型" />
                            <Button Style="{StaticResource AccentButtonStyle}" Command="{Binding BrowseCommand}" Content="导入媒体 / SRT" />
                        </StackPanel>
                    </DockPanel>
                    <Border Grid.Row="2" Style="{StaticResource BentoCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="210" />
                                <ColumnDefinition Width="210" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}" Text="QUEUE" />
                                <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="{Binding InputSummary}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Margin="0,5,0,0" Style="{StaticResource MetaTextStyle}" Text="{Binding Status}" />
                                <ProgressBar Height="3" Margin="0,13,0,0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,18,0">
                                <TextBlock Margin="0,0,0,7" Style="{StaticResource MetaTextStyle}" Text="识别方式" />
                                <ComboBox ItemsSource="{Binding Engines}" SelectedItem="{Binding SelectedEngine}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,18,0">
                                <TextBlock Margin="0,0,0,7" Style="{StaticResource MetaTextStyle}" Text="本地模型" />
                                <ComboBox ItemsSource="{Binding LocalModels}" SelectedItem="{Binding SelectedModel}" DisplayMemberPath="Name" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Button Margin="0,0,8,0" Command="{Binding CancelCommand}" Content="取消" />
                                <Button Style="{StaticResource AccentButtonStyle}" Command="{Binding StartCommand}" Content="开始任务" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource BentoCardStyle}" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <DockPanel Margin="16,0">
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource SectionTitleStyle}" Text="最近任务" />
                                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource MetaTextStyle}" Text="本地历史 · 可恢复" />
                                </DockPanel>
                                <ListBox Grid.Row="1"
                                         ItemsSource="{Binding RecentJobs}"
                                         SelectedItem="{Binding SelectedSubtitleJob}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         AutomationProperties.Name="字幕任务列表">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="12,9" MinWidth="520">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /><ColumnDefinition Width="72" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding InputPath}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource MetaTextStyle}" Text="{Binding OutputPath}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource MetaTextStyle}" Text="{Binding Engine}" />
                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Accent}" FontWeight="SemiBold" Text="{Binding Status}" />
                                                <Button Grid.Column="3" Margin="8,0,0,0" Padding="10,4"
                                                        Command="{Binding DataContext.RetryCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}" Content="重试" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource BentoCardStyle}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}" Text="SUBTITLE" />
                                    <TextBlock Margin="0,12,0,5" Style="{StaticResource SectionTitleStyle}" Text="翻译与导出" />
                                    <TextBlock Style="{StaticResource MetaTextStyle}" Text="先在左侧选择已有字幕的任务。每批译文都会立即保存。" TextWrapping="Wrap" />

                                    <TextBlock Margin="0,14,0,5" Style="{StaticResource MetaTextStyle}" Text="目标语言" />
                                    <TextBox MaxLength="60"
                                             AutomationProperties.Name="字幕翻译目标语言"
                                             Text="{Binding TargetLanguage, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Margin="0,10,0,5" Style="{StaticResource MetaTextStyle}" Text="DeepSeek 模型" />
                                    <TextBox MaxLength="100"
                                             AutomationProperties.Name="字幕翻译模型"
                                             Text="{Binding TranslationModel, UpdateSourceTrigger=PropertyChanged}" />
                                    <ProgressBar Height="4" Margin="0,13,0,0" Maximum="100" Value="{Binding TranslationProgress, Mode=OneWay}" />
                                    <TextBlock Margin="0,7,0,0" Style="{StaticResource MetaTextStyle}" Text="{Binding TranslationStatus}" TextWrapping="Wrap" />
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Button Command="{Binding CancelTranslationCommand}" Content="取消翻译" />
                                        <Button Grid.Column="2" Style="{StaticResource AccentButtonStyle}" Command="{Binding TranslateCommand}" Content="翻译 / 继续" />
                                    </Grid>

                                    <TextBlock Margin="0,16,0,5" Style="{StaticResource MetaTextStyle}" Text="导出格式" />
                                    <ComboBox ItemsSource="{Binding ExportOptions}"
                                              SelectedItem="{Binding SelectedExportOption}"
                                              DisplayMemberPath="Label"
                                              AutomationProperties.Name="字幕导出格式" />
                                    <Button Margin="0,9,0,0" Command="{Binding ExportSubtitleCommand}" Content="导出所选格式" />
                                    <Button Margin="0,8,0,0" Command="{Binding OpenOutputCommand}" Content="打开输出目录" />

                                    <Border Margin="0,14,0,0" Padding="12" Background="{DynamicResource Brush.SurfaceMuted}" CornerRadius="10">
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Text="错误与恢复" />
                                            <TextBlock Margin="0,5,0,0" Style="{StaticResource MetaTextStyle}" Text="{Binding LastError.UserMessage, TargetNullValue=暂无错误}" TextWrapping="Wrap" />
                                            <TextBlock Margin="0,4,0,0" Style="{StaticResource MetaTextStyle}" Text="{Binding LastError.Suggestion}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
                <Grid Margin="28,24,28,28">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <DockPanel LastChildFill="False">
                        <StackPanel><TextBlock Style="{StaticResource PageTitleStyle}" Text="{Binding Title}" /><TextBlock Margin="0,7,0,0" Style="{StaticResource MetaTextStyle}" Text="{Binding Status}" /></StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Margin="0,0,8,0" Command="{Binding RefreshCommand}" Content="刷新" />
                            <Button Margin="0,0,8,0" Command="{Binding RestoreCommand}" Content="恢复备份" />
                            <Button Style="{StaticResource AccentButtonStyle}" Command="{Binding BackupCommand}" Content="立即备份" />
                        </StackPanel>
                    </DockPanel>
                    <TabControl Grid.Row="2"
                                Background="Transparent"
                                BorderThickness="0"
                                SelectedIndex="{Binding SelectedHistoryTabIndex}">
                        <TabItem Header="全局搜索">
                            <Grid Margin="0,12,0,0">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Border Style="{StaticResource BentoCardStyle}">
                                    <views:HistorySearchFilterBar />
                                </Border>
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.6*" MinWidth="430" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" MinWidth="270" /></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource BentoCardStyle}" Padding="0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <ListBox ItemsSource="{Binding SearchResults}"
                                                     SelectedItem="{Binding SelectedSearchResult}"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     AutomationProperties.Name="全局搜索结果">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Padding="18,14" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="76" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Padding="8,4" Background="{DynamicResource Brush.AccentSoft}" CornerRadius="8">
                                                                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}" Text="{Binding TypeLabel}" />
                                                                </Border>
                                                                <StackPanel Grid.Column="1" Margin="4,0,18,0">
                                                                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" />
                                                                    <TextBlock Margin="0,5,0,0" Style="{StaticResource MetaTextStyle}" Text="{Binding Summary}" TextWrapping="Wrap" MaxHeight="42" />
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource MetaTextStyle}" Text="{Binding Source}" />
                                                                    <TextBlock Margin="0,5,0,0" HorizontalAlignment="Right" Style="{StaticResource MetaTextStyle}" Text="{Binding Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm}}" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <Button Grid.Row="1"
                                                    Margin="14,10"
                                                    HorizontalAlignment="Center"
                                                    Padding="18,6"
                                                    AutomationProperties.Name="加载更多搜索结果"
                                                    Command="{Binding LoadMoreSearchResultsCommand}"
                                                    Content="加载更多"
                                                    Visibility="{Binding HasMoreSearchResults, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </Grid>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource BentoCardStyle}">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel>
                                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}" Text="RESULT" />
                                            <TextBlock Margin="0,16,0,8" Style="{StaticResource SectionTitleStyle}" Text="{Binding SelectedSearchResult.Title, TargetNullValue=选择一条搜索结果}" TextWrapping="Wrap" />
                                            <TextBlock Style="{StaticResource MetaTextStyle}" Text="{Binding SelectedSearchResult.Summary, TargetNullValue=结果详情会显示在这里。}" TextWrapping="Wrap" />
                                            <TextBlock Margin="0,14,0,0" FontWeight="SemiBold" Text="{Binding SelectedSearchResult.Source}" />
                                            <TextBlock Margin="0,5,0,0" Style="{StaticResource MetaTextStyle}" Text="{Binding SelectedSearchResult.Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm}}" />
                                            <Button Margin="0,18,0,0"
                                                    AutomationProperties.Name="打开搜索结果"
                                                    Command="{Binding OpenSearchResultCommand}"
                                                    Content="{Binding OpenSearchResultLabel}" />
                                            <Border Margin="0,18,0,0"
                                                    Padding="12"
                                                    Background="{DynamicResource Brush.SurfaceMuted}"
                                                    CornerRadius="8"
                                                    Visibility="{Binding SelectedSearchIsFeedEntry, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold" Text="Feed 私人状态" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               Style="{StaticResource MetaTextStyle}"
                                                               Text="{Binding SelectedSearchPrivateStatus}"
                                                               TextWrapping="Wrap" />
                                                    <StackPanel Margin="0,10,0,0"
                                                                Orientation="Horizontal">
                                                        <Button MinWidth="86"
                                                                Padding="10,5"
                                                                Command="{Binding ToggleSelectedSearchStarCommand}"
                                                                CommandParameter="{Binding SelectedSearchResult}"
                                                                Content="{Binding SelectedSearchStarActionLabel}"
                                                                AutomationProperties.Name="切换历史 Feed 收藏" />
                                                        <Button MinWidth="86"
                                                                Margin="8,0,0,0"
                                                                Padding="10,5"
                                                                Command="{Binding ToggleSelectedSearchReadCommand}"
                                                                CommandParameter="{Binding SelectedSearchResult}"
                                                                Content="{Binding SelectedSearchReadActionLabel}"
                                                                AutomationProperties.Name="切换历史 Feed 已读状态" />
                                                    </StackPanel>
                                                    <TextBlock Margin="0,12,0,5"
                                                               FontWeight="SemiBold"
                                                               Text="私人备注" />
                                                    <TextBox MinHeight="60"
                                                             MaxHeight="110"
                                                             Padding="8,6"
                                                             AcceptsReturn="True"
                                                             MaxLength="4000"
                                                             Text="{Binding SelectedSearchPrivateNote, UpdateSourceTrigger=PropertyChanged}"
                                                             TextWrapping="Wrap"
                                                             VerticalScrollBarVisibility="Auto"
                                                             AutomationProperties.Name="历史 Feed 私人备注" />
                                                    <StackPanel Margin="0,7,0,0"
                                                                HorizontalAlignment="Right"
                                                                Orientation="Horizontal">
                                                        <Button MinWidth="72"
                                                                Padding="10,5"
                                                                Command="{Binding CancelSelectedSearchNoteCommand}"
                                                                Content="取消"
                                                                AutomationProperties.Name="取消历史 Feed 私人备注编辑" />
                                                        <Button MinWidth="88"
                                                                Margin="8,0,0,0"
                                                                Padding="10,5"
                                                                Command="{Binding SaveSelectedSearchNoteCommand}"
                                                                Content="保存"
                                                                AutomationProperties.Name="保存历史 Feed 私人备注" />
                                                    </StackPanel>
                                                    <TextBlock Margin="0,12,0,5"
                                                               FontWeight="SemiBold"
                                                               Text="标签" />
                                                    <DockPanel LastChildFill="True">
                                                        <Button DockPanel.Dock="Right"
                                                                MinWidth="60"
                                                                Margin="8,0,0,0"
                                                                Padding="8,5"
                                                                Command="{Binding AddSelectedSearchTagCommand}"
                                                                Content="添加"
                                                                AutomationProperties.Name="添加历史 Feed 标签" />
                                                        <TextBox MaxLength="80"
                                                                 Padding="8,5"
                                                                 Text="{Binding SelectedSearchTagInput, UpdateSourceTrigger=PropertyChanged}"
                                                                 AutomationProperties.Name="新增历史 Feed 标签" />
                                                    </DockPanel>
                                                    <ItemsControl Margin="0,8,0,0"
                                                                  ItemsSource="{Binding SelectedSearchTags}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Margin="0,0,8,6"
                                                                        Padding="7,3"
                                                                        Background="{DynamicResource Brush.SurfaceRaised}"
                                                                        CornerRadius="4">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock VerticalAlignment="Center"
                                                                                   Text="{Binding Name}" />
                                                                        <Button Margin="6,0,0,0"
                                                                                Padding="3,0"
                                                                                BorderThickness="0"
                                                                                Background="Transparent"
                                                                                Command="{Binding DataContext.RemoveSelectedSearchTagCommand, RelativeSource={RelativeSource AncestorType=TabItem}}"
                                                                                CommandParameter="{Binding}"
                                                                                Content="×"
                                                                                ToolTip="从当前 Feed 条目移除标签"
                                                                                AutomationProperties.Name="移除历史 Feed 标签" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Margin="0,16,0,0" Style="{StaticResource MetaTextStyle}" Text="仅 HTTP/HTTPS 来源会交给系统默认浏览器打开。" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Grid>
                        </TabItem>
                        <TabItem Header="任务历史">
                            <Grid Margin="0,12,0,0">
                                <Grid.RowDefinitions><RowDefinition Height="210" /><RowDefinition Height="14" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Border Style="{StaticResource BentoCardStyle}" Padding="0">
                                    <ListBox ItemsSource="{Binding Jobs}"
                                             SelectedItem="{Binding SelectedJob}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             AutomationProperties.Name="媒体任务历史">
                                        <ListBox.ItemTemplate><DataTemplate>
                                            <Grid Margin="14,10" MinWidth="560">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /><ColumnDefinition Width="120" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                                                <StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding InputPath}" TextTrimming="CharacterEllipsis" /><TextBlock Margin="0,4,0,0" Style="{StaticResource MetaTextStyle}" Text="{Binding OutputPath}" TextTrimming="CharacterEllipsis" /></StackPanel>
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource MetaTextStyle}" Text="{Binding TranslationProvider, TargetNullValue=本地 / 转写}" />
                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource MetaTextStyle}" Text="{Binding Model}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Accent}" FontWeight="SemiBold" Text="{Binding Status}" />
                                            </Grid>
                                        </DataTemplate></ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="310" /></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource BentoCardStyle}" Padding="0">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                            <DockPanel Margin="16,0">
                                                <TextBlock VerticalAlignment="Center" Style="{StaticResource SectionTitleStyle}" Text="字幕片段" />
                                                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource MetaTextStyle}" Text="原文 / 译文" />
                                            </DockPanel>
                                            <ListBox Grid.Row="1"
                                                     ItemsSource="{Binding SubtitleSegments}"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     AutomationProperties.Name="字幕原文与译文详情">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Padding="16,11" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
                                                            <StackPanel>
                                                                <TextBlock Style="{StaticResource MetaTextStyle}" Text="{Binding Sequence, StringFormat=片段 {0}}" />
                                                                <TextBlock Margin="0,5,0,0" Text="{Binding Text}" TextWrapping="Wrap" />
                                                                <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource Brush.Accent}" Text="{Binding TranslatedText, TargetNullValue=尚未翻译}" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Grid>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource BentoCardStyle}">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel>
                                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}" Text="USAGE" />
                                                <TextBlock Margin="0,13,0,5" Style="{StaticResource SectionTitleStyle}" Text="模型与用量" />
                                                <TextBlock FontWeight="SemiBold" Text="{Binding ProviderSummary}" TextWrapping="Wrap" />
                                                <TextBlock Margin="0,6,0,0" Style="{StaticResource MetaTextStyle}" Text="{Binding UsageSummary}" TextWrapping="Wrap" />
                                                <TextBlock Margin="0,14,0,5" FontWeight="SemiBold" Text="脱敏错误" />
                                                <TextBlock Style="{StaticResource MetaTextStyle}" Text="{Binding ErrorSummary}" TextWrapping="Wrap" />

                                                <TextBlock Margin="0,16,0,5" Style="{StaticResource MetaTextStyle}" Text="重新导出" />
                                                <ComboBox ItemsSource="{Binding ExportOptions}"
                                                          SelectedItem="{Binding SelectedExportOption}"
                                                          DisplayMemberPath="Label"
                                                          AutomationProperties.Name="历史字幕导出格式" />
                                                <Button Margin="0,9,0,0" Style="{StaticResource AccentButtonStyle}" Command="{Binding ExportSubtitleCommand}" Content="从本地字幕导出" />
                                                <Button Margin="0,8,0,0" Command="{Binding OpenOutputCommand}" Content="打开输出文件" />
                                                <TextBlock Margin="0,14,0,0" Style="{StaticResource MetaTextStyle}" Text="重新导出只读取本地数据库，不会再次调用模型。" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:FeedAdminViewModel}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Focusable="False">
                    <Grid MinWidth="650" Margin="28,24,28,36">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel LastChildFill="False">
                            <StackPanel>
                                <TextBlock Style="{StaticResource PageTitleStyle}" Text="{Binding Title}" />
                                <TextBlock Margin="0,7,0,0"
                                           Style="{StaticResource MetaTextStyle}"
                                           Text="{Binding Subtitle}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Button DockPanel.Dock="Right"
                                    AutomationProperties.Name="刷新共享订阅目录"
                                    Command="{Binding RefreshCommand}"
                                    Content="刷新目录" />
                        </DockPanel>

                        <Border Grid.Row="2"
                                Padding="14,10"
                                Background="{DynamicResource Brush.SurfaceMuted}"
                                CornerRadius="8">
                            <DockPanel>
                                <TextBlock FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Accent}"
                                           Text="{Binding CatalogVersion, StringFormat=目录版本 v{0}}" />
                                <TextBlock DockPanel.Dock="Right"
                                           Margin="16,0,0,0"
                                           AutomationProperties.LiveSetting="Polite"
                                           Style="{StaticResource MetaTextStyle}"
                                           Text="{Binding Status}"
                                           TextWrapping="Wrap" />
                            </DockPanel>
                        </Border>

                        <TabControl Grid.Row="4">
                            <TabItem Header="发现">
                                <!-- 发现页属于管理员订阅管理，但仍使用独立 ViewModel 隔离只读搜索与目录写入。 -->
                                <views:FeedDiscoveryView DataContext="{Binding UnifiedDiscovery}" />
                            </TabItem>
                            <TabItem Header="分类">
                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="280" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" MinWidth="340" />
                                    </Grid.ColumnDefinitions>

                                    <Border Style="{StaticResource BentoCardStyle}" Padding="0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="52" />
                                                <RowDefinition Height="280" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <DockPanel Margin="16,0">
                                                <TextBlock VerticalAlignment="Center"
                                                           Style="{StaticResource SectionTitleStyle}"
                                                           Text="共享分类" />
                                                <Button DockPanel.Dock="Right"
                                                        Padding="10,5"
                                                        AutomationProperties.Name="新增共享分类"
                                                        Command="{Binding BeginNewCategoryCommand}"
                                                        Content="新增" />
                                            </DockPanel>
                                            <ListBox Grid.Row="1"
                                                     AutomationProperties.Name="共享分类列表"
                                                     ItemsSource="{Binding Categories}"
                                                     SelectedItem="{Binding SelectedCategory}"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="10,7" MinWidth="225">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                                                <TextBlock Margin="0,3,0,0"
                                                                           Style="{StaticResource MetaTextStyle}"
                                                                           Text="{Binding SortOrder, StringFormat=排序 {0}}" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1"
                                                                       VerticalAlignment="Center"
                                                                       Style="{StaticResource MetaTextStyle}"
                                                                       Text="{Binding IsEnabled, StringFormat=启用 {0}}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <Grid Grid.Row="2" Margin="12,10,12,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="6" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="6" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="6" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Button AutomationProperties.Name="分类上移"
                                                        Command="{Binding MoveCategoryUpCommand}"
                                                        CommandParameter="{Binding SelectedCategory}"
                                                        Content="上移" />
                                                <Button Grid.Column="2"
                                                        AutomationProperties.Name="分类下移"
                                                        Command="{Binding MoveCategoryDownCommand}"
                                                        CommandParameter="{Binding SelectedCategory}"
                                                        Content="下移" />
                                                <Button Grid.Column="4"
                                                        AutomationProperties.Name="切换分类启用状态"
                                                        Command="{Binding ToggleCategoryCommand}"
                                                        CommandParameter="{Binding SelectedCategory}"
                                                        Content="启停" />
                                                <Button Grid.Column="6"
                                                        AutomationProperties.Name="删除共享分类"
                                                        Command="{Binding PrepareDeleteCategoryCommand}"
                                                        CommandParameter="{Binding SelectedCategory}"
                                                        Content="删除" />
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Column="2" Style="{StaticResource BentoCardStyle}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="分类编辑器" />
                                            <TextBlock Margin="0,16,0,6" Style="{StaticResource MetaTextStyle}" Text="名称" />
                                            <TextBox MaxLength="80"
                                                     AutomationProperties.Name="分类名称"
                                                     Text="{Binding CategoryNameInput, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Margin="0,12,0,6" Style="{StaticResource MetaTextStyle}" Text="排序（0～1,000,000）" />
                                            <TextBox AutomationProperties.Name="分类排序"
                                                     Text="{Binding CategorySortOrder, UpdateSourceTrigger=PropertyChanged}" />
                                            <CheckBox Margin="0,14,0,0"
                                                      Foreground="{DynamicResource Brush.TextPrimary}"
                                                      IsChecked="{Binding CategoryIsEnabled}"
                                                      Content="允许普通用户同步此分类" />

                                            <Border Margin="0,18,0,0"
                                                    Padding="14"
                                                    Background="{DynamicResource Brush.SurfaceMuted}"
                                                    CornerRadius="8">
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold" Text="AI 处理策略" />
                                                    <TextBlock Margin="0,4,0,12"
                                                               Style="{StaticResource MetaTextStyle}"
                                                               Text="留空或选择继承时使用全局默认；自动处理默认关闭。"
                                                               TextWrapping="Wrap" />
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="10" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="10" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Margin="0,0,0,6" Style="{StaticResource MetaTextStyle}" Text="手动摘要" />
                                                            <ComboBox AutomationProperties.Name="分类手动摘要策略"
                                                                      ItemsSource="{Binding AiPolicySwitchChoices}"
                                                                      DisplayMemberPath="Label"
                                                                      SelectedValuePath="Policy"
                                                                      SelectedValue="{Binding CategoryManualSummaryPolicy}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Margin="0,0,0,6" Style="{StaticResource MetaTextStyle}" Text="自动摘要" />
                                                            <ComboBox AutomationProperties.Name="分类自动摘要策略"
                                                                      ItemsSource="{Binding AiPolicySwitchChoices}"
                                                                      DisplayMemberPath="Label"
                                                                      SelectedValuePath="Policy"
                                                                      SelectedValue="{Binding CategoryAutoSummaryPolicy}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="4">
                                                            <TextBlock Margin="0,0,0,6" Style="{StaticResource MetaTextStyle}" Text="自动翻译" />
                                                            <ComboBox AutomationProperties.Name="分类自动翻译策略"
                                                                      ItemsSource="{Binding AiPolicySwitchChoices}"
                                                                      DisplayMemberPath="Label"
                                                                      SelectedValuePath="Policy"
                                                                      SelectedValue="{Binding CategoryAutoTranslationPolicy}" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <Grid Margin="0,12,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="10" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="10" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Margin="0,0,0,6" Style="{StaticResource MetaTextStyle}" Text="翻译语言" />
                                                            <ComboBox AutomationProperties.Name="分类翻译目标语言"
                                                                      ItemsSource="{Binding AiLanguageChoices}"
                                                                      DisplayMemberPath="Label"
                                                                      SelectedValuePath="Language"
                                                                      SelectedValue="{Binding CategoryTranslationTargetLanguage}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Margin="0,0,0,6" Style="{StaticResource MetaTextStyle}" Text="每日条目（1～1000）" />
                                                            <TextBox AutomationProperties.Name="分类每日 AI 条目上限"
                                                                     Text="{Binding CategoryAiDailyEntryLimit, UpdateSourceTrigger=PropertyChanged}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="4">
                                                            <TextBlock Margin="0,0,0,6" Style="{StaticResource MetaTextStyle}" Text="并发（1～4）" />
                                                            <TextBox AutomationProperties.Name="分类 AI 并发上限"
                                                                     Text="{Binding CategoryAiMaxConcurrency, UpdateSourceTrigger=PropertyChanged}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    <TextBlock Margin="0,12,0,0"
                                                               AutomationProperties.Name="分类 AI 用量预估"
                                                               Foreground="{DynamicResource Brush.Accent}"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding CategoryAiUsageEstimate}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                            <Button Margin="0,18,0,0"
                                                    HorizontalAlignment="Left"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    AutomationProperties.Name="保存共享分类"
                                                    Command="{Binding SaveCategoryCommand}"
                                                    Content="保存分类" />

                                            <Border Margin="0,18,0,0"
                                                    Padding="12"
                                                    Background="{DynamicResource Brush.SurfaceMuted}"
                                                    CornerRadius="8"
                                                    Visibility="{Binding IsCategoryDeletePending, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold" Text="确认删除分类？" />
                                                    <TextBlock Margin="0,5,0,10"
                                                               Style="{StaticResource MetaTextStyle}"
                                                               Text="若分类仍含 Feed，Worker 会拒绝删除。"
                                                               TextWrapping="Wrap" />
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Margin="0,0,8,0"
                                                                AutomationProperties.Name="取消删除分类"
                                                                Command="{Binding CancelDeleteCategoryCommand}"
                                                                Content="取消" />
                                                        <Button AutomationProperties.Name="确认删除分类"
                                                                Command="{Binding ConfirmDeleteCategoryCommand}"
                                                                Content="确认删除" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </TabItem>

                            <TabItem Header="Feed">
                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="300" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" MinWidth="360" />
                                    </Grid.ColumnDefinitions>

                                    <Border Style="{StaticResource BentoCardStyle}" Padding="0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="52" />
                                                <RowDefinition Height="420" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <DockPanel Margin="16,0">
                                                <TextBlock VerticalAlignment="Center"
                                                           Style="{StaticResource SectionTitleStyle}"
                                                           Text="共享 Feed" />
                                                <Button DockPanel.Dock="Right"
                                                        Padding="10,5"
                                                        AutomationProperties.Name="新增共享 Feed"
                                                        Command="{Binding BeginNewFeedCommand}"
                                                        Content="新增" />
                                            </DockPanel>
                                            <ListBox Grid.Row="1"
                                                     AutomationProperties.Name="共享 Feed 列表"
                                                     ItemsSource="{Binding Feeds}"
                                                     SelectedItem="{Binding SelectedFeed}"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="10,7" MinWidth="245">
                                                            <DockPanel>
                                                                <TextBlock FontWeight="SemiBold"
                                                                           Text="{Binding DisplayName}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock DockPanel.Dock="Right"
                                                                           Style="{StaticResource MetaTextStyle}"
                                                                           Text="{Binding IsEnabled, StringFormat=启用 {0}}" />
                                                            </DockPanel>
                                                            <TextBlock Margin="0,4,0,0"
                                                                       Style="{StaticResource MetaTextStyle}"
                                                                       Text="{Binding OriginalUrl}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <Grid Grid.Row="2" Margin="12,10,12,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="6" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="6" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="6" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Button AutomationProperties.Name="Feed 上移"
                                                        Command="{Binding MoveFeedUpCommand}"
                                                        CommandParameter="{Binding SelectedFeed}"
                                                        Content="上移" />
                                                <Button Grid.Column="2"
                                                        AutomationProperties.Name="Feed 下移"
                                                        Command="{Binding MoveFeedDownCommand}"
                                                        CommandParameter="{Binding SelectedFeed}"
                                                        Content="下移" />
                                                <Button Grid.Column="4"
                                                        AutomationProperties.Name="切换 Feed 启用状态"
                                                        Command="{Binding ToggleFeedCommand}"
                                                        CommandParameter="{Binding SelectedFeed}"
                                                        Content="启停" />
                                                <Button Grid.Column="6"
                                                        AutomationProperties.Name="删除共享 Feed"
                                                        Command="{Binding PrepareDeleteFeedCommand}"
                                                        CommandParameter="{Binding SelectedFeed}"
                                                        Content="删除" />
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Column="2" Style="{StaticResource BentoCardStyle}">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Feed 编辑器" />
                                                <TextBlock Margin="0,16,0,6" Style="{StaticResource MetaTextStyle}" Text="站点或 Feed URL" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox MaxLength="2048"
                                                             AutomationProperties.Name="Feed 地址"
                                                             Text="{Binding FeedUrlInput, UpdateSourceTrigger=PropertyChanged}" />
                                                    <Button Grid.Column="2"
                                                            AutomationProperties.Name="安全验证 Feed 地址"
                                                            Command="{Binding DiscoverCommand}"
                                                            Content="安全验证" />
                                                </Grid>

                                                <Border Margin="0,12,0,0"
                                                        Padding="12"
                                                        AutomationProperties.Name="Feed 安全验证预览"
                                                        Background="{DynamicResource Brush.SurfaceMuted}"
                                                        CornerRadius="8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock FontWeight="SemiBold" Text="{Binding DiscoveryTitle}" />
                                                            <TextBlock Margin="0,4,0,0"
                                                                       Style="{StaticResource MetaTextStyle}"
                                                                       Text="{Binding DiscoverySite}"
                                                                       TextWrapping="Wrap" />
                                                            <TextBlock Margin="0,6,0,0"
                                                                       Style="{StaticResource MetaTextStyle}"
                                                                       Text="{Binding DiscoveryWarning}"
                                                                       TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1"
                                                                   Margin="12,0,0,0"
                                                                   Foreground="{DynamicResource Brush.Accent}"
                                                                   FontWeight="SemiBold"
                                                                   Text="{Binding DiscoveryType}" />
                                                    </Grid>
                                                </Border>

                                                <TextBlock Margin="0,14,0,6" Style="{StaticResource MetaTextStyle}" Text="显示名称" />
                                                <TextBox MaxLength="160"
                                                         AutomationProperties.Name="Feed 显示名称"
                                                         Text="{Binding FeedDisplayNameInput, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Margin="0,12,0,6" Style="{StaticResource MetaTextStyle}" Text="站点地址（可选）" />
                                                <TextBox MaxLength="2048"
                                                         AutomationProperties.Name="Feed 站点地址"
                                                         Text="{Binding FeedSiteUrlInput, UpdateSourceTrigger=PropertyChanged}" />

                                                <Grid Margin="0,12,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="10" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Margin="0,0,0,6" Style="{StaticResource MetaTextStyle}" Text="分类" />
                                                        <ComboBox AutomationProperties.Name="Feed 分类"
                                                                  ItemsSource="{Binding CategoryChoices}"
                                                                  DisplayMemberPath="Name"
                                                                  SelectedValuePath="Id"
                                                                  SelectedValue="{Binding SelectedCategoryId}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Margin="0,0,0,6" Style="{StaticResource MetaTextStyle}" Text="视图类型" />
                                                        <ComboBox AutomationProperties.Name="Feed 视图类型"
                                                                  ItemsSource="{Binding ViewKindChoices}"
                                                                  DisplayMemberPath="Label"
                                                                  SelectedItem="{Binding SelectedViewKind}" />
                                                    </StackPanel>
                                                </Grid>

                                                <Grid Margin="0,12,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="10" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Margin="0,0,0,6" Style="{StaticResource MetaTextStyle}" Text="刷新间隔（分钟）" />
                                                        <TextBox AutomationProperties.Name="Feed 刷新间隔"
                                                                 Text="{Binding FeedRefreshIntervalMinutes, UpdateSourceTrigger=PropertyChanged}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Margin="0,0,0,6" Style="{StaticResource MetaTextStyle}" Text="排序" />
                                                        <TextBox AutomationProperties.Name="Feed 排序"
                                                                 Text="{Binding FeedSortOrder, UpdateSourceTrigger=PropertyChanged}" />
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock Margin="0,12,0,6"
                                                           Style="{StaticResource MetaTextStyle}"
                                                           Text="全文抓取策略" />
