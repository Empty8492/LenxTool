                                             controls:PasswordBoxAssistant.BoundPassword="{Binding CredentialInput, Mode=TwoWay}" />
                                <DockPanel Margin="0,16,0,0"
                                           LastChildFill="False">
                                    <StackPanel>
                                        <TextBlock AutomationProperties.LiveSetting="Polite"
                                                   Style="{StaticResource MetaTextStyle}"
                                                   Text="{Binding Status}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Style="{StaticResource MetaTextStyle}"
                                                   Text="{Binding HasCredential, StringFormat=已保存凭据：{0}}" />
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Right"
                                                Margin="16,0,0,0"
                                                Orientation="Horizontal">
                                        <Button Margin="0,0,8,0"
                                                AutomationProperties.Name="删除个人外部集成凭据"
                                                Command="{Binding DeleteCredentialCommand}"
                                                Content="删除凭据" />
                                        <Button Margin="0,0,8,0"
                                                AutomationProperties.Name="测试个人外部集成连接"
                                                Command="{Binding TestCommand}"
                                                Content="测试连接" />
                                        <Button Style="{StaticResource AccentButtonStyle}"
                                                AutomationProperties.Name="保存个人外部集成"
                                                Command="{Binding SaveCommand}"
                                                Content="本机保存" />
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <Border Margin="0,16,0,0"
                                DataContext="{Binding ZoteroSettings}"
                                Style="{StaticResource BentoCardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitleStyle}"
                                           Text="Zotero 文献导出" />
