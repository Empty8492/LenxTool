                                                    <TextBlock Style="{StaticResource MetaTextStyle}" Text="{Binding SelectedSourceSummary}" />
                                                </Border>
                                                <Button Command="{Binding GenerateDailyTrendReportCommand}"
                                                        AutomationProperties.Name="生成每日趋势 AI 报告"
                                                        Content="生成趋势报告" />
