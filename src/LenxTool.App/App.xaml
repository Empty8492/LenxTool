                                                                <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}" Text="{Binding Platform}" />
                                                                <TextBlock Margin="6,0,0,0" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" Text="{Binding Count}" />
                                                            </StackPanel>
                                                        </ToggleButton>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Button Grid.Column="1"
                                                    Margin="8,0,0,8"
                                                    MinHeight="32"
                                                    Padding="11,6"
                                                    VerticalAlignment="Top"
                                                    Command="{Binding SelectAllSourcesCommand}"
                                                    AutomationProperties.Name="选择全部热点来源"
                                                    Content="全选" />
                                        </Grid>
                                    </Grid>
                                </Border>
                                <Grid Grid.Row="2">
                                <ItemsControl ItemsSource="{Binding TrendGroups}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <controls:ViewportDeferredContentControl
                                                DeferredContent="{Binding}"
                                                DeferredContentTemplate="{StaticResource TrendPlatformCardTemplate}"
                                                EstimatedHeight="720"
