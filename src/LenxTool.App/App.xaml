                                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="多源热点" />
                                                <TextBlock Margin="0,4,0,0" Style="{StaticResource MetaTextStyle}" Text="按平台分组展示，每组独立排名；点击条目可查看原文" />
