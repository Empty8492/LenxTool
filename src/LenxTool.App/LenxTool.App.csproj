<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\LenxTool.Core\LenxTool.Core.csproj" />
    <ProjectReference Include="..\LenxTool.Infrastructure\LenxTool.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LenxTool.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\installer\update-public-key.pem"
                      Link="Resources\update-public-key.pem"
                      LogicalName="LenxTool.UpdatePublicKey" />
    <Resource Include="Assets\LenxTools.ico" />
    <None Update="Controls\FluentScrollViewer.LICENSE.txt"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
    <!-- App notifications live in Foundation; Runtime supplies unpackaged
         bootstrap/version metadata. Avoid the full metapackage's WinUI/AI/ML. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.3.5" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.3" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.3.1" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Keep startup independent from Windows App Runtime. The notification
         adapter bootstraps it lazily and fails closed when it is unavailable. -->
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
    <WindowsAppSdkIncludeVersionInfo>true</WindowsAppSdkIncludeVersionInfo>
    <!-- Keep the existing WPF WebView2 projection when WinAppSDK is present. -->
    <WebView2EnableCsWinRTProjection>false</WebView2EnableCsWinRTProjection>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\LenxTools.ico</ApplicationIcon>
    <AssemblyName>LenxTool</AssemblyName>
    <RootNamespace>LenxTool.App</RootNamespace>
    <AssemblyTitle>Lenx Tools</AssemblyTitle>
    <Title>Lenx Tools</Title>
    <Product>Lenx Tools</Product>
    <Version>0.1.0</Version>
  </PropertyGroup>

</Project>
