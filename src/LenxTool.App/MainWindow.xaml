<Window x:Class="LenxTool.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="Lenx Tools"
        Icon="Assets/LenxTool.ico"
        Width="1380"
        Height="860"
        MinWidth="920"
        MinHeight="620"
        Background="{DynamicResource Brush.Sidebar}"
        PreviewKeyDown="OnPreviewKeyDown"
        ResizeMode="CanResize"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="36" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.SurfaceMuted}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.Focus}" />
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="K" Modifiers="Control" Command="{Binding OpenCommandPaletteCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CloseCommandPaletteCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="TitleBarSidebarSurface"
                    Background="{DynamicResource Brush.Sidebar}">
                <StackPanel Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Image Width="14"
                           Height="14"
                           Source="Assets/LenxTool.ico"
                           Stretch="Uniform" />
                    <TextBlock Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{DynamicResource Brush.TextOnDarkMuted}"
                               Text="Lenx Tools" />
                </StackPanel>
            </Border>

            <Border x:Name="TitleBarWorkspaceSurface"
                    Grid.Column="1"
                    Background="{DynamicResource Brush.Window}">
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource CaptionButtonStyle}"
                            AutomationProperties.Name="最小化窗口"
                            Click="MinimizeWindow"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="最小化">
                        <Path Width="12"
                              Height="12"
                              Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4"
                              Data="M1,8 L11,8" />
                    </Button>
                    <Button Style="{StaticResource CaptionButtonStyle}"
                            AutomationProperties.Name="最大化或还原窗口"
                            Click="ToggleMaximizeWindow"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="最大化或还原">
                        <Path Width="12"
                              Height="12"
                              Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.3"
                              Data="M1,1 L11,1 11,11 1,11 Z" />
                    </Button>
                    <Button Style="{StaticResource CaptionButtonStyle}"
                            AutomationProperties.Name="关闭窗口"
                            Click="CloseWindow"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="关闭">
                        <Path Width="12"
                              Height="12"
                              Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4"
                              Data="M2,2 L10,10 M10,2 L2,10" />
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="SidebarSurface"
                Background="{DynamicResource Brush.Sidebar}"
                BorderBrush="{DynamicResource Brush.SidebarRaised}"
                BorderThickness="0,0,1,0">
            <Grid Margin="18,20,18,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="32" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" Background="{DynamicResource Brush.Accent}" CornerRadius="9">
                        <Path Width="18" Height="18" Stretch="Uniform" Stroke="White" StrokeThickness="1.7"
                              Data="M3,4 L9,4 9,14 15,14 15,20 3,20 Z M12,4 L20,4 20,11 12,11 Z" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextOnDark}" Text="LENX TOOLS" />
                        <TextBlock Margin="0,2,0,0" FontSize="10" Foreground="{DynamicResource Brush.TextOnDarkMuted}" Text="LOCAL-FIRST DESKTOP" />
                    </StackPanel>
                </Grid>

                <ListBox Grid.Row="2"
                         ItemsSource="{Binding NavigationItems}"
                         SelectedValue="{Binding SelectedPageId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         SelectedValuePath="Id"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,0,0,5" />
                            <Setter Property="Padding" Value="12,10" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextOnDarkMuted}" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="SelectionChrome" Padding="{TemplateBinding Padding}" Background="Transparent" CornerRadius="8">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SelectionChrome" Property="Background" Value="{DynamicResource Brush.SidebarRaised}" /></Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="SelectionChrome" Property="Background" Value="{DynamicResource Brush.SidebarRaised}" />
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextOnDark}" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SelectionChrome" Property="BorderBrush" Value="{DynamicResource Brush.Focus}" /><Setter TargetName="SelectionChrome" Property="BorderThickness" Value="1" /></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Path Width="17" Height="17" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" StrokeThickness="1.6" Data="{Binding IconData}" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Text="{Binding Label}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="3" Padding="12" Background="{DynamicResource Brush.SidebarRaised}" CornerRadius="10">
                    <StackPanel>
                        <DockPanel>
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource Brush.Success}" />
                            <TextBlock Margin="8,0,0,0" FontSize="11" Foreground="{DynamicResource Brush.TextOnDark}" Text="本地数据可用" />
                        </DockPanel>
                        <TextBlock Margin="0,7,0,0"
                                   FontSize="10"
                                   Foreground="{DynamicResource Brush.TextOnDarkMuted}"
                                   Text="{Binding CloudAccountStatus}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="{DynamicResource Brush.Window}">
            <Grid.RowDefinitions><RowDefinition Height="64" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border x:Name="WorkspaceHeader"
                    Background="{DynamicResource Brush.Window}">
                <Grid Margin="28,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.TextSecondary}"
                               Text="LENX / WORKSPACE" />
                    <Button Grid.Column="1" Command="{Binding OpenCommandPaletteCommand}" ToolTip="打开全局命令面板 (Ctrl+K)">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="14" Height="14" Margin="0,0,8,0" Stretch="Uniform" Stroke="{DynamicResource Brush.TextSecondary}" StrokeThickness="1.7" Data="M9,3 A6,6 0 1 0 9,15 A6,6 0 1 0 9,3 M13.5,13.5 L19,19" />
                            <TextBlock Foreground="{DynamicResource Brush.TextSecondary}" Text="搜索与命令" />
                            <Border Margin="16,0,0,0" Padding="6,2" Background="{DynamicResource Brush.SurfaceMuted}" CornerRadius="4"><TextBlock FontSize="10" Foreground="{DynamicResource Brush.TextSecondary}" Text="Ctrl K" /></Border>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NotificationButton"
                            Grid.Column="3"
                            Width="38"
                            Height="38"
                            Padding="9"
                            AutomationProperties.Name="通知"
                            Command="{Binding NotificationCenter.ToggleCommand}"
                            ToolTip="通知">
                        <Grid>
                            <Path Stretch="Uniform"
                                  Stroke="{DynamicResource Brush.TextSecondary}"
                                  StrokeThickness="1.6"
                                  Data="M12,3 C8,3 6,6 6,10 L6,14 4,17 20,17 18,14 18,10 C18,6 16,3 12,3 Z M10,20 C11,21 13,21 14,20" />
                            <Border MinWidth="16"
                                    Height="16"
                                    Margin="14,-12,-12,14"
                                    Padding="4,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource Brush.Accent}"
                                    CornerRadius="8"
                                    Visibility="{Binding NotificationCenter.HasUnread, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           Text="{Binding NotificationCenter.BadgeText}" />
                            </Border>
                        </Grid>
                    </Button>
                    <Popup Grid.Column="3"
                           Width="380"
                           MaxHeight="520"
                           AllowsTransparency="True"
                           HorizontalOffset="-342"
                           IsOpen="{Binding NotificationCenter.IsOpen, Mode=TwoWay}"
                           Placement="Bottom"
                           PlacementTarget="{Binding ElementName=NotificationButton}"
                           StaysOpen="False"
                           VerticalOffset="8">
                        <Border Padding="16"
                                Background="{DynamicResource Brush.SurfaceRaised}"
                                BorderBrush="{DynamicResource Brush.BorderStrong}"
                                BorderThickness="1"
                                CornerRadius="12"
                                DataContext="{Binding NotificationCenter}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="22"
                                                  Opacity="0.22"
                                                  ShadowDepth="6" />
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock FontSize="17"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                                   Text="通知" />
                                        <TextBlock Margin="0,3,0,0"
                                                   Style="{StaticResource MetaTextStyle}"
                                                   Text="{Binding UnreadCount, StringFormat=未读 {0} 条}" />
                                    </StackPanel>
                                    <Button MinWidth="82"
                                            Margin="12,0,0,0"
                                            Padding="10,6"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Command="{Binding MarkAllReadCommand}"
                                            Content="全部已读" />
                                </DockPanel>

                                <ComboBox Grid.Row="1"
                                          Margin="0,10,0,0"
                                          MinHeight="34"
                                          ItemsSource="{Binding KindFilters}"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding SelectedKindFilter, Mode=TwoWay}"
                                          AutomationProperties.Name="通知类别筛选" />

                                <Grid Grid.Row="3">
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource Brush.TextSecondary}"
                                               Text="暂无通知">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ScrollViewer MaxHeight="400"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Margin="0,0,0,8"
                                                            Padding="12"
                                                            HorizontalContentAlignment="Stretch"
                                                            Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Style>
                                                            <Style TargetType="Button"
                                                                   BasedOn="{StaticResource {x:Type Button}}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsRead}" Value="True">
                                                                        <Setter Property="Opacity" Value="0.62" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="10" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Width="6"
                                                                    Height="6"
                                                                    Margin="0,6,0,0"
                                                                    VerticalAlignment="Top"
                                                                    Background="{DynamicResource Brush.Accent}"
                                                                    CornerRadius="3">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsRead}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                            </Border>
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Margin="0,0,0,4"
                                                                           FontSize="10"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource Brush.Accent}"
                                                                           Text="{Binding KindLabel}" />
                                                                <TextBlock FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                                                           Text="{Binding Title}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <DockPanel Margin="0,5,0,0">
                                                                    <TextBlock Style="{StaticResource MetaTextStyle}"
                                                                               Text="{Binding SourceLabel}" />
                                                                    <TextBlock Margin="10,0,0,0"
                                                                               Style="{StaticResource MetaTextStyle}"
                                                                               Text="{Binding CreatedAt, StringFormat={}{0:MM-dd HH:mm}}" />
                                                                </DockPanel>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>
                        </Border>
                    </Popup>
                </Grid>
            </Border>
            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" />
        </Grid>

        <Grid Grid.ColumnSpan="2"
              Panel.ZIndex="20"
              Background="#99000000"
              Visibility="{Binding IsCommandPaletteOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="620" MaxHeight="520" Margin="24,100,24,24" Padding="1" VerticalAlignment="Top"
                    Background="{DynamicResource Brush.BorderStrong}" CornerRadius="14">
                <Border Padding="18" Background="{DynamicResource Brush.SurfaceRaised}" CornerRadius="13">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Path Width="17" Height="17" Stretch="Uniform" Stroke="{DynamicResource Brush.TextSecondary}" StrokeThickness="1.7" Data="M9,3 A6,6 0 1 0 9,15 A6,6 0 1 0 9,3 M13.5,13.5 L19,19" />
                            <TextBox x:Name="CommandSearchBox" Grid.Column="1" BorderThickness="0" Background="Transparent" FontSize="16" Text="{Binding CommandQuery, UpdateSourceTrigger=PropertyChanged}" />
                            <Border Grid.Column="2" Padding="7,3" Background="{DynamicResource Brush.SurfaceMuted}" CornerRadius="4"><TextBlock Style="{StaticResource MetaTextStyle}" Text="ESC" /></Border>
                        </Grid>
                        <ItemsControl Grid.Row="2" ItemsSource="{Binding FilteredCommands}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,0,0,6" Padding="12" HorizontalContentAlignment="Stretch"
                                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Id}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Path Width="17" Height="17" Stretch="Uniform" Stroke="{DynamicResource Brush.Accent}" StrokeThickness="1.6" Data="{Binding IconData}" />
                                            <StackPanel Grid.Column="1"><TextBlock FontWeight="SemiBold" Text="{Binding Label}" /><TextBlock Margin="0,3,0,0" Style="{StaticResource MetaTextStyle}" Text="{Binding Description}" /></StackPanel>
                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource MetaTextStyle}" Text="打开" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Grid.Row="3" Margin="3,10,0,0" Style="{StaticResource MetaTextStyle}" Text="输入页面名称或功能关键词 · Tab 导航 · Enter 执行" />
                    </Grid>
                </Border>
            </Border>
        </Grid>
        </Grid>
    </Grid>
</Window>
