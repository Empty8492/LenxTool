<UserControl x:Class="LenxTool.App.Views.FeedTimelineBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LenxTool.App.Controls">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource BentoCardStyle}" Padding="0" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="42" />
                </Grid.RowDefinitions>
                <controls:PagedListBox ItemsSource="{Binding TimelineEntries}"
                                       SelectedItem="{Binding SelectedTimelineEntry}"
                                       LoadMoreCommand="{Binding LoadMoreTimelineCommand}"
                                       Background="Transparent"
                                       BorderThickness="0"
                                       ScrollViewer.CanContentScroll="True"
                                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                       ScrollViewer.VerticalScrollBarVisibility="Auto"
                                       VirtualizingPanel.IsVirtualizing="True"
                                       VirtualizingPanel.VirtualizationMode="Recycling"
                                       AutomationProperties.Name="资讯列表">
                    <controls:PagedListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                        </Style>
                    </controls:PagedListBox.ItemContainerStyle>
                    <controls:PagedListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="16,13">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <DockPanel LastChildFill="True">
                                    <StackPanel DockPanel.Dock="Right"
                                                Orientation="Horizontal">
                                        <Button Margin="4,0,0,0"
                                                Padding="4,0"
                                                BorderThickness="0"
                                                Background="Transparent"
                                                Command="{Binding DataContext.ToggleTimelineStarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Content="{Binding StarGlyph}"
                                                ToolTip="切换收藏"
                                                AutomationProperties.Name="切换 Feed 收藏" />
                                        <Button Margin="4,0,0,0"
                                                Padding="4,0"
                                                BorderThickness="0"
                                                Background="Transparent"
                                                Command="{Binding DataContext.ToggleTimelineReadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Content="{Binding ReadGlyph}"
                                                ToolTip="切换已读状态"
                                                AutomationProperties.Name="切换 Feed 已读状态" />
                                    </StackPanel>
                                    <TextBlock DockPanel.Dock="Right"
                                               Margin="8,0,0,0"
                                               Style="{StaticResource MetaTextStyle}"
                                               Text="{Binding DisplayTime, StringFormat={}{0:MM-dd HH:mm}}" />
                                    <TextBlock FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Accent}"
                                               Text="{Binding FeedName}"
                                               TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <TextBlock Grid.Row="1"
                                           Margin="0,6,0,0"
                                           FontWeight="SemiBold"
                                           Text="{Binding Entry.Title}"
                                           TextTrimming="CharacterEllipsis" />
                                <DockPanel Grid.Row="2" Margin="0,6,0,0">
                                    <Border DockPanel.Dock="Left"
                                            Margin="0,0,8,0"
                                            Padding="6,2"
                                            Background="{DynamicResource Brush.SurfaceMuted}"
                                            CornerRadius="4">
                                        <TextBlock FontSize="11"
                                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                                   Text="{Binding CategoryName}" />
                                    </Border>
                                    <TextBlock Style="{StaticResource MetaTextStyle}"
                                               Text="{Binding Summary}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock DockPanel.Dock="Right"
                                               Margin="8,0,0,0"
                                               Style="{StaticResource MetaTextStyle}"
                                               Text="{Binding Progress, StringFormat={}{0:0}%}" />
                                </DockPanel>
                            </Grid>
                        </DataTemplate>
                    </controls:PagedListBox.ItemTemplate>
                </controls:PagedListBox>
                <Border Grid.Row="1"
                        Padding="14,0"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="0,1,0,0">
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                MinWidth="88"
                                Margin="8,4,0,4"
                                Padding="10,4"
                                Command="{Binding LoadMoreTimelineCommand}"
                                AutomationProperties.Name="继续加载 Feed 条目"
                                Content="继续加载" />
                        <TextBlock VerticalAlignment="Center"
                                   Style="{StaticResource MetaTextStyle}"
                                   Text="{Binding TimelineEntrySummary}" />
                    </DockPanel>
                </Border>
                <Border Grid.RowSpan="2"
                        Margin="0"
                        Padding="20"
                        Panel.ZIndex="10"
                        Background="{DynamicResource Brush.SurfaceRaised}"
                        IsHitTestVisible="False"
                        CornerRadius="10">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TimelineEntries.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center"
                                   Style="{StaticResource SectionTitleStyle}"
                                   Text="暂无匹配条目" />
                        <TextBlock Margin="0,6,0,0"
                                   HorizontalAlignment="Center"
                                   Style="{StaticResource MetaTextStyle}"
                                   Text="已登录时目录与 Feed 会在后台同步；断网时保留本地缓存。"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource BentoCardStyle}" Padding="0" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0"
                              MaxHeight="360"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <Border Padding="18,14"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="0,0,0,1">
                        <StackPanel>
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right"
                                        Orientation="Horizontal">
                                <Button MinWidth="72"
                                        Padding="10,5"
                                        Command="{Binding ToggleTimelineStarCommand}"
                                        CommandParameter="{Binding SelectedTimelineEntry}"
                                        Content="{Binding SelectedTimelineEntry.StarActionLabel}"
                                        AutomationProperties.Name="切换当前 Feed 收藏" />
                                <Button MinWidth="72"
                                        Margin="8,0,0,0"
                                        Padding="10,5"
                                        Command="{Binding ToggleTimelineReadCommand}"
                                        CommandParameter="{Binding SelectedTimelineEntry}"
                                        Content="{Binding SelectedTimelineEntry.ReadActionLabel}"
                                        AutomationProperties.Name="切换当前 Feed 已读状态" />
                                <Button MinWidth="72"
                                        Margin="8,0,0,0"
                                        Padding="10,5"
                                        Command="{Binding ResetTimelineProgressCommand}"
                                        Content="从头阅读"
                                        Click="ResetTimelineProgressClick"
                                        AutomationProperties.Name="重置 Feed 阅读进度" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitleStyle}"
                                           Text="私人阅读状态" />
                                <TextBlock Margin="0,3,12,0"
                                           Style="{StaticResource MetaTextStyle}"
                                           Text="{Binding SelectedTimelineEntry.Progress, StringFormat={}阅读进度 {0:0}%}" />
                                <TextBlock Margin="0,3,12,0"
                                           Style="{StaticResource MetaTextStyle}"
                                           Text="{Binding TimelineEditorStatus}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>

                        <TextBlock Margin="0,12,0,5"
                                   FontWeight="SemiBold"
                                   Text="私人备注" />
                        <TextBox MinHeight="64"
                                 MaxHeight="110"
                                 Padding="9,7"
                                 AcceptsReturn="True"
                                 MaxLength="4000"
                                 Text="{Binding SelectedTimelineNote, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="Feed 私人备注" />
                        <StackPanel Margin="0,7,0,0"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal">
                            <Button MinWidth="80"
                                    Padding="12,5"
                                    Command="{Binding CancelTimelineNoteEditCommand}"
                                    Content="取消"
                                    AutomationProperties.Name="取消 Feed 私人备注编辑" />
                            <Button MinWidth="96"
                                    Margin="8,0,0,0"
                                    Padding="12,5"
                                    Command="{Binding SaveTimelineNoteCommand}"
                                    Content="保存备注"
                                    AutomationProperties.Name="保存 Feed 私人备注" />
                        </StackPanel>

                        <TextBlock Margin="0,12,0,5"
                                   FontWeight="SemiBold"
                                   Text="标签" />
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right"
                                    MinWidth="72"
                                    Margin="8,0,0,0"
                                    Padding="10,5"
                                    Command="{Binding AddTimelineTagCommand}"
                                    Content="添加"
                                    AutomationProperties.Name="添加 Feed 标签" />
                            <TextBox MaxLength="80"
                                     Padding="9,6"
                                     Text="{Binding TimelineTagInput, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="新增 Feed 标签" />
                        </DockPanel>
                        <ItemsControl Margin="0,8,0,0"
                                      ItemsSource="{Binding SelectedTimelineTags}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,8,6"
                                            Padding="8,3"
                                            Background="{DynamicResource Brush.SurfaceMuted}"
                                            CornerRadius="4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock VerticalAlignment="Center"
                                                       Text="{Binding Name}" />
                                            <Button Margin="6,0,0,0"
                                                    Padding="3,0"
                                                    BorderThickness="0"
                                                    Background="Transparent"
                                                    Command="{Binding DataContext.RemoveTimelineTagCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Content="×"
                                                    ToolTip="从当前条目移除标签"
                                                    AutomationProperties.Name="移除 Feed 标签" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
                <ScrollViewer x:Name="ArticleScrollViewer"
                              Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly"
                              ScrollChanged="ArticleScrollViewer_OnScrollChanged">
                    <controls:RichArticleView Article="{Binding SelectedFeedArticle}" />
                </ScrollViewer>
                <Border Grid.RowSpan="2"
                        Margin="0"
                        Padding="20"
                        Panel.ZIndex="10"
                        Background="{DynamicResource Brush.SurfaceRaised}"
                        IsHitTestVisible="False"
                        CornerRadius="10">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTimelineEntry}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center"
                                   Style="{StaticResource SectionTitleStyle}"
                                   Text="选择一条 Feed 内容" />
                        <TextBlock Margin="0,6,0,0"
                                   HorizontalAlignment="Center"
                                   Style="{StaticResource MetaTextStyle}"
                                   Text="正文使用现有原生只读阅读器，不执行来源脚本。"
                                   TextAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
