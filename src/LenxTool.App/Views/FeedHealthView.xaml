<UserControl x:Class="LenxTool.App.Views.FeedHealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border MinWidth="860"
            Height="520"
            Margin="0,16,0,0"
            Padding="0"
            Style="{StaticResource BentoCardStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
                <RowDefinition Height="36" />
            </Grid.RowDefinitions>
            <DockPanel Margin="20,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Feed 健康与诊断" />
                    <TextBlock Margin="0,4,0,0"
                               Style="{StaticResource MetaTextStyle}"
                               Text="{Binding HealthSummary}" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Right"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite"
                           Style="{StaticResource MetaTextStyle}"
                           Text="{Binding HealthStatus}"
                           TextWrapping="Wrap" />
            </DockPanel>
            <ListBox Grid.Row="1"
                     Margin="8,0"
                     AutomationProperties.Name="Feed 健康状态列表"
                     ItemsSource="{Binding HealthItems}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.CanContentScroll="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="12,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="105" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold"
                                           Text="{Binding Feed.DisplayName}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Margin="0,3,0,0"
                                           Style="{StaticResource MetaTextStyle}"
                                           Text="{Binding Feed.OriginalUrl}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Style="{StaticResource MetaTextStyle}" Text="状态" />
                                <TextBlock Margin="0,3,0,0" Text="{Binding StatusLabel}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="12,0,0,0">
                                <TextBlock Style="{StaticResource MetaTextStyle}" Text="错误类别" />
                                <TextBlock Margin="0,3,0,0" Text="{Binding ErrorLabel}" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Margin="12,0,0,0">
                                <TextBlock Style="{StaticResource MetaTextStyle}" Text="最后成功" />
                                <TextBlock Margin="0,3,0,0"
                                           Text="{Binding LastSuccessText}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="4" Margin="12,0,0,0">
                                <TextBlock Style="{StaticResource MetaTextStyle}" Text="最后失败 / 下次" />
                                <TextBlock Margin="0,3,0,0"
                                           Text="{Binding LastFailureText}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Margin="0,2,0,0"
                                           Style="{StaticResource MetaTextStyle}"
                                           Text="{Binding NextRetryText}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Grid.Column="5"
                                    MinWidth="82"
                                    Margin="14,0,4,0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="重试当前 Feed"
                                    Command="{Binding DataContext.RetryFeedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Content="立即重试" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Border Grid.Row="1"
                    Margin="28"
                    Padding="22"
                    Background="{DynamicResource Brush.SurfaceRaised}"
                    IsHitTestVisible="False"
                    CornerRadius="10">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HealthItems.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock HorizontalAlignment="Center"
                               Style="{StaticResource SectionTitleStyle}"
                               Text="暂无 Feed 抓取状态" />
                    <TextBlock Margin="0,6,0,0"
                               HorizontalAlignment="Center"
                               Style="{StaticResource MetaTextStyle}"
                               Text="管理员登录后可读取本机最近一次抓取结果。"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <TextBlock Grid.Row="2"
                       Margin="20,0"
                       VerticalAlignment="Center"
                       Style="{StaticResource MetaTextStyle}"
                       Text="错误只显示固定类别；重试仍经过原有地址、响应大小、超时和解析安全策略。" />
        </Grid>
    </Border>
</UserControl>
