<UserControl x:Class="LenxTool.App.Views.FeedDiscoveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <!-- DISC-04 只呈现发现结果；候选发布入口将在 DISC-05 接入服务端写入保护后再增加。 -->
    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  Focusable="False">
        <Grid MinWidth="650" Margin="28,24,28,36">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Style="{StaticResource PageTitleStyle}"
                           Text="{Binding Title}" />
                <TextBlock Margin="0,7,0,0"
                           Style="{StaticResource MetaTextStyle}"
                           Text="{Binding Subtitle}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Border Grid.Row="2"
                    Style="{StaticResource BentoCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleStyle}"
                                       Text="统一发现" />
                            <TextBlock Margin="0,4,0,0"
                                       Style="{StaticResource MetaTextStyle}"
                                       Text="支持关键词、HTTP/HTTPS 地址和 RSSHub 路由；输入停止后会自动搜索。"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Border DockPanel.Dock="Right"
                                Margin="14,0,0,0"
                                Padding="10,5"
                                VerticalAlignment="Top"
                                Background="{DynamicResource Brush.SurfaceMuted}"
                                CornerRadius="12">
                            <TextBlock AutomationProperties.Name="发现输入识别类型"
                                       Foreground="{DynamicResource Brush.Accent}"
                                       FontWeight="SemiBold"
                                       Text="{Binding QueryKindLabel}" />
                        </Border>
                    </DockPanel>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox AutomationProperties.Name="统一发现输入"
                                 MaxLength="2048"
                                 Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter"
                                            Command="{Binding SearchCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="2"
                                MinWidth="88"
                                Style="{StaticResource AccentButtonStyle}"
                                AutomationProperties.Name="提交统一发现"
                                Command="{Binding SearchCommand}"
                                Content="搜索" />
                        <Button Grid.Column="4"
                                MinWidth="72"
                                AutomationProperties.Name="取消统一发现"
                                Command="{Binding CancelCommand}"
                                Content="取消" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="4"
                    Padding="14,10"
                    Background="{DynamicResource Brush.SurfaceMuted}"
                    CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar Width="54"
                                 Height="4"
                                 VerticalAlignment="Center"
                                 IsIndeterminate="True"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Grid.Column="2"
                               AutomationProperties.LiveSetting="Polite"
                               Style="{StaticResource MetaTextStyle}"
                               Text="{Binding Status}"
                               TextWrapping="Wrap" />
                    <Button Grid.Column="3"
                            MinWidth="72"
                            Margin="12,0,0,0"
                            AutomationProperties.Name="重试统一发现"
                            Command="{Binding RetryCommand}"
                            Content="重试"
                            Visibility="{Binding CanShowRetry, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
            </Border>

            <Border Grid.Row="6"
                    Padding="22"
                    Style="{StaticResource BentoCardStyle}"
                    AutomationProperties.Name="统一发现空状态"
                    Visibility="{Binding ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock HorizontalAlignment="Center"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Text="等待发现结果" />
                    <TextBlock Margin="0,7,0,0"
                               MaxWidth="520"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Style="{StaticResource MetaTextStyle}"
                               Text="{Binding Status}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <ItemsControl Grid.Row="6"
                          AutomationProperties.Name="统一发现候选列表"
                          ItemsSource="{Binding Candidates}"
                          Visibility="{Binding HasCandidates, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,12"
                                Style="{StaticResource BentoCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="2*" MinWidth="220" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <DockPanel LastChildFill="False">
                                        <TextBlock FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding Title}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Border DockPanel.Dock="Right"
                                                Margin="12,0,0,0"
                                                Padding="9,4"
                                                Background="{DynamicResource Brush.SurfaceMuted}"
                                                CornerRadius="10">
                                            <TextBlock Foreground="{DynamicResource Brush.Accent}"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding HealthText}" />
                                        </Border>
                                    </DockPanel>
                                    <TextBlock Margin="0,7,0,0"
                                               Style="{StaticResource MetaTextStyle}"
                                               Text="{Binding FeedUrl}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,5,0,0"
                                               Style="{StaticResource MetaTextStyle}"
                                               Text="{Binding SiteText}"
                                               TextWrapping="Wrap" />
                                    <WrapPanel Margin="0,12,0,0">
                                        <TextBlock FontWeight="SemiBold"
                                                   Text="{Binding DocumentKindText}" />
                                        <TextBlock Margin="8,0,0,0"
                                                   Style="{StaticResource MetaTextStyle}"
                                                   Text="{Binding SourceText}" />
                                        <TextBlock Margin="8,0,0,0"
                                                   Style="{StaticResource MetaTextStyle}"
                                                   Text="{Binding UpdatedText}" />
                                    </WrapPanel>
                                    <TextBlock Margin="0,8,0,0"
                                               Foreground="{DynamicResource Brush.Warning}"
                                               Text="{Binding WarningText}"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource SectionTitleStyle}"
                                               Text="近期预览" />
                                    <TextBlock Margin="0,4,0,10"
                                               Style="{StaticResource MetaTextStyle}"
                                               Text="{Binding PreviewStatus}"
                                               TextWrapping="Wrap" />
                                    <ItemsControl ItemsSource="{Binding RecentEntries}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Title}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1"
                                                               Margin="10,0,0,0"
                                                               Style="{StaticResource MetaTextStyle}"
                                                               Text="{Binding PublishedText}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </ScrollViewer>
</UserControl>
