<UserControl x:Class="LenxTool.App.Views.FeedDiscoveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <!-- 搜索与发布保持两步：候选先预览，目录写入必须在独立面板显式确认。 -->
    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  Focusable="False">
        <Grid MinWidth="650" Margin="28,24,28,36">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Style="{StaticResource PageTitleStyle}"
                           Text="{Binding Title}" />
                <TextBlock Margin="0,7,0,0"
                           Style="{StaticResource MetaTextStyle}"
                           Text="{Binding Subtitle}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Border Grid.Row="2"
                    Style="{StaticResource BentoCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleStyle}"
                                       Text="统一发现" />
                            <TextBlock Margin="0,4,0,0"
                                       Style="{StaticResource MetaTextStyle}"
                                       Text="支持关键词、HTTP/HTTPS 地址和 RSSHub 路由；输入停止后会自动搜索。"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Border DockPanel.Dock="Right"
                                Margin="14,0,0,0"
                                Padding="10,5"
                                VerticalAlignment="Top"
                                Background="{DynamicResource Brush.SurfaceMuted}"
                                CornerRadius="12">
                            <TextBlock AutomationProperties.Name="发现输入识别类型"
                                       Foreground="{DynamicResource Brush.Accent}"
                                       FontWeight="SemiBold"
                                       Text="{Binding QueryKindLabel}" />
                        </Border>
                    </DockPanel>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox AutomationProperties.Name="统一发现输入"
                                 MaxLength="2048"
                                 IsEnabled="{Binding CanEditDiscoveryInput}"
                                 Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter"
                                            Command="{Binding SearchCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="2"
                                MinWidth="88"
                                Style="{StaticResource AccentButtonStyle}"
                                AutomationProperties.Name="提交统一发现"
                                Command="{Binding SearchCommand}"
                                Content="搜索" />
                        <Button Grid.Column="4"
                                MinWidth="72"
                                AutomationProperties.Name="取消统一发现"
                                Command="{Binding CancelCommand}"
                                Content="取消" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="4"
                    Padding="14,10"
                    Background="{DynamicResource Brush.SurfaceMuted}"
                    CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar Width="54"
                                 Height="4"
                                 VerticalAlignment="Center"
                                 IsIndeterminate="True"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Grid.Column="2"
                               AutomationProperties.LiveSetting="Polite"
                               Style="{StaticResource MetaTextStyle}"
                               Text="{Binding Status}"
                               TextWrapping="Wrap" />
                    <Button Grid.Column="3"
                            MinWidth="72"
                            Margin="12,0,0,0"
                            AutomationProperties.Name="重试统一发现"
                            Command="{Binding RetryCommand}"
                            Content="重试"
                            Visibility="{Binding CanShowRetry, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
            </Border>

            <Border Grid.Row="6"
                    Padding="22"
                    Style="{StaticResource BentoCardStyle}"
                    AutomationProperties.Name="统一发现空状态"
                    Visibility="{Binding ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock HorizontalAlignment="Center"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Text="等待发现结果" />
                    <TextBlock Margin="0,7,0,0"
                               MaxWidth="520"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Style="{StaticResource MetaTextStyle}"
                               Text="{Binding Status}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <ItemsControl Grid.Row="6"
                          AutomationProperties.Name="统一发现候选列表"
                          ItemsSource="{Binding Candidates}"
                          Visibility="{Binding HasCandidates, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,12"
                                Style="{StaticResource BentoCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="2*" MinWidth="220" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <DockPanel LastChildFill="False">
                                        <TextBlock FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding Title}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Border DockPanel.Dock="Right"
                                                Margin="12,0,0,0"
                                                Padding="9,4"
                                                Background="{DynamicResource Brush.SurfaceMuted}"
                                                CornerRadius="10">
                                            <TextBlock Foreground="{DynamicResource Brush.Accent}"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding HealthText}" />
                                        </Border>
                                    </DockPanel>
                                    <TextBlock Margin="0,7,0,0"
                                               Style="{StaticResource MetaTextStyle}"
                                               Text="{Binding FeedUrl}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,5,0,0"
                                               Style="{StaticResource MetaTextStyle}"
                                               Text="{Binding SiteText}"
                                               TextWrapping="Wrap" />
                                    <WrapPanel Margin="0,12,0,0">
                                        <TextBlock FontWeight="SemiBold"
                                                   Text="{Binding DocumentKindText}" />
                                        <TextBlock Margin="8,0,0,0"
                                                   Style="{StaticResource MetaTextStyle}"
                                                   Text="{Binding SourceText}" />
                                        <TextBlock Margin="8,0,0,0"
                                                   Style="{StaticResource MetaTextStyle}"
                                                   Text="{Binding UpdatedText}" />
                                    </WrapPanel>
                                    <TextBlock Margin="0,8,0,0"
                                               Foreground="{DynamicResource Brush.Warning}"
                                               Text="{Binding WarningText}"
                                               TextWrapping="Wrap" />
                                    <Button Margin="0,14,0,0"
                                            MinWidth="132"
                                            HorizontalAlignment="Left"
                                            Style="{StaticResource AccentButtonStyle}"
                                            AutomationProperties.Name="准备加入共享目录"
                                            Command="{Binding DataContext.PreparePublishCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                            CommandParameter="{Binding}"
                                            Content="{Binding PrimaryActionLabel}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource SectionTitleStyle}"
                                               Text="近期预览" />
                                    <TextBlock Margin="0,4,0,10"
                                               Style="{StaticResource MetaTextStyle}"
                                               Text="{Binding PreviewStatus}"
                                               TextWrapping="Wrap" />
                                    <ItemsControl ItemsSource="{Binding RecentEntries}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Title}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1"
                                                               Margin="10,0,0,0"
                                                               Style="{StaticResource MetaTextStyle}"
                                                               Text="{Binding PublishedText}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Grid.Row="8"
                    Style="{StaticResource BentoCardStyle}"
                    AutomationProperties.Name="发布确认面板"
                    Visibility="{Binding HasPublishSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel LastChildFill="False">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleStyle}"
                                       Text="{Binding PublishPanelTitle}" />
                            <TextBlock Margin="0,4,0,0"
                                       Style="{StaticResource MetaTextStyle}"
                                       Text="{Binding PublishValidationText}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Right"
                                   Margin="18,0,0,0"
                                   VerticalAlignment="Top"
                                   Foreground="{DynamicResource Brush.Accent}"
                                   FontWeight="SemiBold"
                                   Text="{Binding CatalogVersion, StringFormat=目录 v{0}}" />
                    </DockPanel>

                    <StackPanel Grid.Row="2">
                        <TextBlock FontWeight="SemiBold"
                                   Text="规范化 Feed 地址" />
                        <Border Margin="0,6,0,0"
                                Padding="12,9"
                                Background="{DynamicResource Brush.SurfaceMuted}"
                                CornerRadius="7">
                            <TextBlock Text="{Binding PublishNormalizedUrl}"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="分类" />
                            <ComboBox Margin="0,6,0,0"
                                      AutomationProperties.Name="发布分类"
                                      ItemsSource="{Binding PublishCategories}"
                                      DisplayMemberPath="Label"
                                      SelectedItem="{Binding SelectedPublishCategory}"
                                      IsEnabled="{Binding CanEditPublishPolicy}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock FontWeight="SemiBold" Text="刷新策略" />
                            <ComboBox Margin="0,6,0,0"
                                      AutomationProperties.Name="发布刷新策略"
                                      ItemsSource="{Binding PublishRefreshChoices}"
                                      SelectedItem="{Binding SelectedPublishRefreshMinutes}"
                                      IsEnabled="{Binding CanEditPublishPolicy}" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="视图策略" />
                            <ComboBox Margin="0,6,0,0"
                                      AutomationProperties.Name="发布视图策略"
                                      ItemsSource="{Binding PublishViewChoices}"
                                      DisplayMemberPath="Label"
                                      SelectedItem="{Binding SelectedPublishView}"
                                      IsEnabled="{Binding CanEditPublishPolicy}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock FontWeight="SemiBold" Text="全文策略" />
                            <ComboBox Margin="0,6,0,0"
                                      AutomationProperties.Name="发布全文策略"
                                      ItemsSource="{Binding PublishFullTextChoices}"
                                      DisplayMemberPath="Label"
                                      SelectedItem="{Binding SelectedPublishFullText}"
                                      IsEnabled="{Binding CanEditPublishPolicy}" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <CheckBox AutomationProperties.Name="确认发布设置"
                                  IsChecked="{Binding IsPublishConfirmed}"
                                  IsEnabled="{Binding CanEditPublishPolicy}"
                                  Visibility="{Binding ShowPublishConfirmation, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  Content="我已核对规范化地址、分类、刷新、视图与全文策略。" />
                        <WrapPanel Grid.Row="2">
                            <Button MinWidth="142"
                                    Style="{StaticResource AccentButtonStyle}"
                                    AutomationProperties.Name="确认加入共享目录"
                                    Command="{Binding PublishCommand}"
                                    Content="确认加入共享目录"
                                    Visibility="{Binding ShowPublishConfirmation, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button MinWidth="92"
                                    Margin="10,0,0,0"
                                    AutomationProperties.Name="取消发布确认"
                                    Command="{Binding CancelPublishCommand}"
                                    Content="关闭" />
                            <Button MinWidth="112"
                                    Margin="10,0,0,0"
                                    AutomationProperties.Name="刷新发布目录"
                                    Command="{Binding RefreshCatalogCommand}"
                                    Content="刷新目录" />
                        </WrapPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
