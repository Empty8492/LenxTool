<UserControl x:Class="LenxTool.App.Views.ToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LenxTool.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:ToolsViewModel}"
             d:DesignHeight="760"
             d:DesignWidth="1120"
             mc:Ignorable="d">
    <Grid Margin="32,28,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Style="{StaticResource PageTitleStyle}"
                       Text="{Binding Title}" />
            <TextBlock Margin="0,7,0,0"
                       Style="{StaticResource MetaTextStyle}"
                       Text="{Binding Subtitle}" />
        </StackPanel>

        <TabControl Grid.Row="2"
                    AutomationProperties.Name="文档与数据工具模式">
            <TabItem Header="转换与校验">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <WrapPanel>
                        <Button Margin="0,0,8,8" Command="{Binding FormatJsonCommand}" Content="格式化 JSON" />
                        <Button Margin="0,0,8,8" Command="{Binding MinifyJsonCommand}" Content="压缩" />
                        <Button Margin="0,0,8,8" Command="{Binding SortJsonCommand}" Content="键排序" />
                        <Button Margin="0,0,8,8" Command="{Binding ValidateJsonCommand}" Content="校验" />
                        <Button Margin="0,0,8,8" Command="{Binding EncodeBase64Command}" Content="Base64 编码" />
                        <Button Margin="0,0,8,8" Command="{Binding DecodeBase64Command}" Content="Base64 解码" />
                        <Button Margin="0,0,8,8" Command="{Binding EncodeUrlCommand}" Content="URL 编码" />
                        <Button Margin="0,0,8,8" Command="{Binding DecodeUrlCommand}" Content="URL 解码" />
                        <Button Margin="0,0,8,8" Command="{Binding CleanTextCommand}" Content="清理文本" />
                        <Button Margin="0,0,8,8" Command="{Binding HashFileCommand}" Content="SHA-256 文件校验" />
                        <Button Margin="0,0,8,8" Command="{Binding WordToPdfCommand}" Content="Word 转 PDF" />
                    </WrapPanel>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Padding="0" Style="{StaticResource BentoCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="42" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Margin="16,0"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Text="输入" />
                                <TextBox Grid.Row="1"
                                         Padding="16"
                                         AcceptsReturn="True"
                                         AcceptsTab="True"
                                         AutomationProperties.Name="工具输入"
                                         FontFamily="Cascadia Mono, Consolas"
                                         HorizontalScrollBarVisibility="Auto"
                                         Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalScrollBarVisibility="Auto" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button Width="38"
                                    Height="38"
                                    Padding="8"
                                    AutomationProperties.Name="交换工具输入与结果"
                                    Command="{Binding SwapCommand}"
                                    ToolTip="交换输入与输出">
                                <Path Data="M4,8 L18,8 15,5 M18,8 15,11 M20,16 L6,16 9,13 M6,16 9,19"
                                      Stretch="Uniform"
                                      Stroke="{DynamicResource Brush.Accent}"
                                      StrokeThickness="1.6" />
                            </Button>
                        </StackPanel>
                        <Border Grid.Column="2" Padding="0" Style="{StaticResource BentoCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="42" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="34" />
                                </Grid.RowDefinitions>
                                <TextBlock Margin="16,0"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Text="结果" />
                                <TextBox Grid.Row="1"
                                         Padding="16"
                                         AcceptsReturn="True"
                                         AutomationProperties.Name="工具结果"
                                         FontFamily="Cascadia Mono, Consolas"
                                         HorizontalScrollBarVisibility="Auto"
                                         IsReadOnly="True"
                                         Text="{Binding Output}"
                                         VerticalScrollBarVisibility="Auto" />
                                <TextBlock Grid.Row="2"
                                           Margin="16,0"
                                           VerticalAlignment="Center"
                                           AutomationProperties.LiveSetting="Polite"
                                           Style="{StaticResource MetaTextStyle}"
                                           Text="{Binding Status}" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="JSON 结构 Diff">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="4" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="3*" />
                    </Grid.RowDefinitions>

                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <Button Margin="0,0,8,0"
                                    AutomationProperties.Name="比较 JSON 结构"
                                    Command="{Binding CompareJsonCommand}"
                                    Content="开始比较"
                                    Style="{StaticResource AccentButtonStyle}" />
                            <Button Margin="0,0,8,0"
                                    AutomationProperties.Name="取消 JSON 比较"
                                    Command="{Binding CancelJsonDiffCommand}"
                                    Content="取消" />
                            <Button AutomationProperties.Name="交换左右 JSON"
                                    Command="{Binding SwapJsonSidesCommand}"
                                    Content="交换左右" />
                        </StackPanel>
                        <TextBlock Margin="16,0,0,0"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   Style="{StaticResource MetaTextStyle}"
                                   Text="每侧最多 2,097,152 个字符 · 最多显示 500 处差异" />
                    </DockPanel>

                    <ProgressBar Grid.Row="1"
                                 Height="3"
                                 IsIndeterminate="True"
                                 Visibility="{Binding IsJsonDiffRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Padding="0" Style="{StaticResource BentoCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="44" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <DockPanel Margin="16,0">
                                    <TextBlock VerticalAlignment="Center"
                                               FontWeight="SemiBold"
                                               Text="左侧 JSON" />
                                    <TextBlock DockPanel.Dock="Right"
                                               VerticalAlignment="Center"
                                               AutomationProperties.LiveSetting="Polite"
                                               Style="{StaticResource MetaTextStyle}"
                                               Text="{Binding LeftJsonStatus}" />
                                </DockPanel>
                                <TextBox Grid.Row="1"
                                         MinHeight="150"
                                         Padding="16"
                                         AcceptsReturn="True"
                                         AutomationProperties.Name="左侧 JSON"
                                         FontFamily="Cascadia Mono, Consolas"
                                         HorizontalScrollBarVisibility="Auto"
                                         SpellCheck.IsEnabled="False"
                                         Text="{Binding LeftJson, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalScrollBarVisibility="Auto" />
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Padding="0" Style="{StaticResource BentoCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="44" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <DockPanel Margin="16,0">
                                    <TextBlock VerticalAlignment="Center"
                                               FontWeight="SemiBold"
                                               Text="右侧 JSON" />
                                    <TextBlock DockPanel.Dock="Right"
                                               VerticalAlignment="Center"
                                               AutomationProperties.LiveSetting="Polite"
                                               Style="{StaticResource MetaTextStyle}"
                                               Text="{Binding RightJsonStatus}" />
                                </DockPanel>
                                <TextBox Grid.Row="1"
                                         MinHeight="150"
                                         Padding="16"
                                         AcceptsReturn="True"
                                         AutomationProperties.Name="右侧 JSON"
                                         FontFamily="Cascadia Mono, Consolas"
                                         HorizontalScrollBarVisibility="Auto"
                                         SpellCheck.IsEnabled="False"
                                         Text="{Binding RightJson, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalScrollBarVisibility="Auto" />
                            </Grid>
                        </Border>
                    </Grid>

                    <TextBlock Grid.Row="5"
                               AutomationProperties.LiveSetting="Polite"
                               Style="{StaticResource MetaTextStyle}"
                               Text="{Binding JsonDiffStatus}"
                               TextWrapping="Wrap" />

                    <Border Grid.Row="7" Padding="0" Style="{StaticResource BentoCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="42" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="3*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="路径" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Text="类型" />
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold" Text="左值" />
                                <TextBlock Grid.Column="3" VerticalAlignment="Center" FontWeight="SemiBold" Text="右值" />
                            </Grid>
                            <Grid Grid.Row="1">
                                <TextBlock Margin="16"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource MetaTextStyle}"
                                           Text="{Binding JsonDiffEmptyText}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding ShowJsonDiffEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <ListBox ItemsSource="{Binding Differences}"
                                         AutomationProperties.Name="JSON 结构差异列表"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         HorizontalContentAlignment="Stretch"
                                         ScrollViewer.CanContentScroll="True"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                         Visibility="{Binding HasDifferences, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="16,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="3*" />
                                                    <ColumnDefinition Width="3*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center"
                                                           FontFamily="Cascadia Mono, Consolas"
                                                           Text="{Binding Path}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Brush.Accent}"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding KindText}" />
                                                <TextBlock Grid.Column="2"
                                                           Margin="0,0,12,0"
                                                           VerticalAlignment="Center"
                                                           FontFamily="Cascadia Mono, Consolas"
                                                           Text="{Binding LeftValue}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="3"
                                                           VerticalAlignment="Center"
                                                           FontFamily="Cascadia Mono, Consolas"
                                                           Text="{Binding RightValue}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
