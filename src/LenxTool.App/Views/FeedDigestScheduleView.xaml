<UserControl x:Class="LenxTool.App.Views.FeedDigestScheduleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="订阅摘要计划管理">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="18,12"
                Background="{DynamicResource Brush.SurfaceMuted}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="10">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        MinWidth="76"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        Command="{Binding RefreshCommand}"
                        AutomationProperties.Name="刷新订阅摘要计划"
                        Content="刷新" />
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}"
                               Text="自动订阅摘要" />
                    <TextBlock Margin="0,4,0,0"
                               Style="{StaticResource MetaTextStyle}"
                               Text="按本机时区聚合 ACTIVE 订阅；空窗口和命中缓存都不会再次调用模型。"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,5,0,0"
                               Style="{StaticResource MetaTextStyle}"
                               AutomationProperties.LiveSetting="Polite"
                               Text="{Binding Status}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource BentoCardStyle}">
                <StackPanel>
                    <DockPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleStyle}"
                                       Text="每日摘要" />
                            <TextBlock Margin="0,4,0,0"
                                       Style="{StaticResource MetaTextStyle}"
                                       Text="上一个本地日历窗口" />
                        </StackPanel>
                        <CheckBox DockPanel.Dock="Right"
                                  Margin="16,0,0,0"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding DailyEnabled}"
                                  AutomationProperties.Name="启用每日摘要计划"
                                  Content="启用" />
                    </DockPanel>
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Margin="0,0,0,6"
                                       Style="{StaticResource MetaTextStyle}"
                                       Text="时间" />
                            <TextBox MaxLength="5"
                                     Text="{Binding DailyTimeText, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="每日摘要执行时间" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Margin="0,0,0,6"
                                       Style="{StaticResource MetaTextStyle}"
                                       Text="范围" />
                            <ComboBox ItemsSource="{Binding ScopeChoices}"
                                      DisplayMemberPath="Label"
                                      SelectedItem="{Binding DailySelectedScope}"
                                      AutomationProperties.Name="每日摘要订阅范围" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Margin="0,14,0,6"
                               Style="{StaticResource MetaTextStyle}"
                               Text="关键词（可选）" />
                    <TextBox MaxLength="200"
                             Text="{Binding DailySearchText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="每日摘要关键词" />
                    <DockPanel Margin="0,16,0,0">
                        <TextBlock VerticalAlignment="Center"
                                   Style="{StaticResource MetaTextStyle}"
                                   Text="{Binding DailyNextRunText}"
                                   TextWrapping="Wrap" />
                        <Button DockPanel.Dock="Right"
                                MinWidth="96"
                                Margin="16,0,0,0"
                                Style="{StaticResource AccentButtonStyle}"
                                Command="{Binding SaveDailyCommand}"
                                AutomationProperties.Name="保存每日摘要计划"
                                Content="保存每日" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Style="{StaticResource BentoCardStyle}">
                <StackPanel>
                    <DockPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleStyle}"
                                       Text="每周摘要" />
                            <TextBlock Margin="0,4,0,0"
                                       Style="{StaticResource MetaTextStyle}"
                                       Text="上一个本地周历窗口" />
                        </StackPanel>
                        <CheckBox DockPanel.Dock="Right"
                                  Margin="16,0,0,0"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding WeeklyEnabled}"
                                  AutomationProperties.Name="启用每周摘要计划"
                                  Content="启用" />
                    </DockPanel>
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Margin="0,0,0,6"
                                       Style="{StaticResource MetaTextStyle}"
                                       Text="星期" />
                            <ComboBox ItemsSource="{Binding WeekdayChoices}"
                                      DisplayMemberPath="Label"
                                      SelectedItem="{Binding SelectedWeeklyDay}"
                                      AutomationProperties.Name="每周摘要执行星期" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Margin="0,0,0,6"
                                       Style="{StaticResource MetaTextStyle}"
                                       Text="时间" />
                            <TextBox MaxLength="5"
                                     Text="{Binding WeeklyTimeText, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="每周摘要执行时间" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Margin="0,0,0,6"
                                       Style="{StaticResource MetaTextStyle}"
                                       Text="范围" />
                            <ComboBox ItemsSource="{Binding ScopeChoices}"
                                      DisplayMemberPath="Label"
                                      SelectedItem="{Binding WeeklySelectedScope}"
                                      AutomationProperties.Name="每周摘要订阅范围" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Margin="0,14,0,6"
                               Style="{StaticResource MetaTextStyle}"
                               Text="关键词（可选）" />
                    <TextBox MaxLength="200"
                             Text="{Binding WeeklySearchText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="每周摘要关键词" />
                    <DockPanel Margin="0,16,0,0">
                        <TextBlock VerticalAlignment="Center"
                                   Style="{StaticResource MetaTextStyle}"
                                   Text="{Binding WeeklyNextRunText}"
                                   TextWrapping="Wrap" />
                        <Button DockPanel.Dock="Right"
                                MinWidth="96"
                                Margin="16,0,0,0"
                                Style="{StaticResource AccentButtonStyle}"
                                Command="{Binding SaveWeeklyCommand}"
                                AutomationProperties.Name="保存每周摘要计划"
                                Content="保存每周" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
