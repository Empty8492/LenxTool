<UserControl x:Class="LenxTool.App.Views.FeedTimelineFiltersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Padding="18,14" Style="{StaticResource BentoCardStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="共享 Feed 时间线" />
                    <TextBlock Margin="0,4,0,0"
                               Style="{StaticResource MetaTextStyle}"
                               Text="{Binding TimelineStatus}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Margin="16,0,0,0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Margin="0,0,8,0"
                            Command="{Binding ClearTimelineFiltersCommand}"
                            AutomationProperties.Name="清除 Feed 筛选"
                            Content="清除筛选" />
                    <Button Style="{StaticResource AccentButtonStyle}"
                            Command="{Binding ApplyTimelineFiltersCommand}"
                            AutomationProperties.Name="应用 Feed 筛选"
                            Content="应用筛选" />
                </StackPanel>
            </Grid>
            <WrapPanel Grid.Row="2">
                <StackPanel Width="170" Margin="0,0,10,8">
                    <TextBlock Margin="2,0,0,5"
                               Style="{StaticResource MetaTextStyle}"
                               Text="分类" />
                    <ComboBox MinHeight="36"
                              Style="{StaticResource CompactComboBoxStyle}"
                              ItemsSource="{Binding TimelineCategories}"
                              SelectedItem="{Binding SelectedTimelineCategory}"
                              DisplayMemberPath="Label"
                              AutomationProperties.Name="Feed 分类筛选" />
                </StackPanel>
                <StackPanel Width="190" Margin="0,0,10,8">
                    <TextBlock Margin="2,0,0,5"
                               Style="{StaticResource MetaTextStyle}"
                               Text="Feed" />
                    <ComboBox MinHeight="36"
                              Style="{StaticResource CompactComboBoxStyle}"
                              ItemsSource="{Binding TimelineFeeds}"
                              SelectedItem="{Binding SelectedTimelineFeed}"
                              DisplayMemberPath="Label"
                              AutomationProperties.Name="Feed 来源筛选" />
                </StackPanel>
                <StackPanel Width="150" Margin="0,0,10,8">
                    <TextBlock Margin="2,0,0,5"
                               Style="{StaticResource MetaTextStyle}"
                               Text="发布日期" />
                    <DatePicker MinHeight="36"
                                SelectedDate="{Binding SelectedTimelineDate}"
                                AutomationProperties.Name="Feed 日期筛选" />
                </StackPanel>
                <StackPanel Width="230" Margin="0,0,0,8">
                    <TextBlock Margin="2,0,0,5"
                               Style="{StaticResource MetaTextStyle}"
                               Text="关键词" />
                    <TextBox MaxLength="200"
                             Text="{Binding TimelineKeyword, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Feed 关键词筛选" />
                </StackPanel>
            </WrapPanel>
        </Grid>
    </Border>
</UserControl>
