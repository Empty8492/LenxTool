<UserControl x:Class="LenxTool.App.Views.HistorySearchFilterBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="210"
             d:DesignWidth="980">
    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitleStyle}"
                           Text="搜索本地内容" />
                <TextBox Margin="0,10,0,0"
                         MaxLength="200"
                         AutomationProperties.Name="全局搜索关键词"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter"
                                    Command="{Binding SearchCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <TextBlock Margin="0,8,0,0"
                           Style="{StaticResource MetaTextStyle}"
                           Text="{Binding SearchStatus}" />
            </StackPanel>
            <Button Grid.Column="2"
                    MinWidth="92"
                    VerticalAlignment="Bottom"
                    Style="{StaticResource AccentButtonStyle}"
                    Command="{Binding SearchCommand}"
                    Content="搜索" />
        </Grid>
        <WrapPanel Margin="0,16,0,0">
            <StackPanel Width="138" Margin="0,0,10,8">
                <TextBlock Margin="0,0,0,5"
                           Style="{StaticResource MetaTextStyle}"
                           Text="内容类型" />
                <ComboBox AutomationProperties.Name="搜索内容类型"
                          ItemsSource="{Binding SearchTypeOptions}"
                          DisplayMemberPath="Label"
                          SelectedItem="{Binding SelectedSearchType}" />
            </StackPanel>
            <StackPanel Width="140" Margin="0,0,10,8">
                <TextBlock Margin="0,0,0,5"
                           Style="{StaticResource MetaTextStyle}"
                           Text="起始日期" />
                <DatePicker AutomationProperties.Name="搜索起始日期"
                            SelectedDate="{Binding SearchPublishedFrom}" />
            </StackPanel>
            <StackPanel Width="140" Margin="0,0,10,8">
                <TextBlock Margin="0,0,0,5"
                           Style="{StaticResource MetaTextStyle}"
                           Text="截止日期" />
                <DatePicker AutomationProperties.Name="搜索截止日期"
                            SelectedDate="{Binding SearchPublishedBefore}" />
            </StackPanel>
            <StackPanel Width="150" Margin="0,0,10,8">
                <TextBlock Margin="0,0,0,5"
                           Style="{StaticResource MetaTextStyle}"
                           Text="Feed 分类" />
                <ComboBox AutomationProperties.Name="搜索 Feed 分类"
                          ItemsSource="{Binding SearchCategories}"
                          DisplayMemberPath="Label"
                          SelectedItem="{Binding SelectedSearchCategory}" />
            </StackPanel>
            <StackPanel Width="170" Margin="0,0,10,8">
                <TextBlock Margin="0,0,0,5"
                           Style="{StaticResource MetaTextStyle}"
                           Text="Feed 来源" />
                <ComboBox AutomationProperties.Name="搜索 Feed 来源"
                          ItemsSource="{Binding SearchFeeds}"
                          DisplayMemberPath="Label"
                          SelectedItem="{Binding SelectedSearchFeed}" />
            </StackPanel>
            <StackPanel Width="140" Margin="0,0,10,8">
                <TextBlock Margin="0,0,0,5"
                           Style="{StaticResource MetaTextStyle}"
                           Text="标签" />
                <ComboBox AutomationProperties.Name="搜索标签"
                          ItemsSource="{Binding SearchTags}"
                          DisplayMemberPath="Label"
                          SelectedItem="{Binding SelectedSearchTag}" />
            </StackPanel>
            <CheckBox Margin="0,24,12,8"
                      VerticalAlignment="Center"
                      AutomationProperties.Name="仅搜索收藏"
                      Content="仅收藏"
                      IsChecked="{Binding SearchFavoritesOnly}" />
            <Button Margin="0,20,0,8"
                    Padding="12,5"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="清除搜索筛选"
                    Command="{Binding ClearSearchFiltersCommand}"
                    Content="清除筛选" />
        </WrapPanel>
    </StackPanel>
</UserControl>
