<UserControl x:Class="LenxTool.App.Views.FeedNotificationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LenxTool.App.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Padding="18,14"
                Style="{StaticResource BentoCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleStyle}"
                                   Text="通知流" />
                        <TextBlock Margin="0,4,0,0"
                                   Style="{StaticResource MetaTextStyle}"
                                   Text="{Binding NotificationFeed.Status}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Margin="0,0,8,0"
                                Command="{Binding NotificationFeed.ClearFiltersCommand}"
                                AutomationProperties.Name="清除通知筛选"
                                Content="清除筛选" />
                        <Button Style="{StaticResource AccentButtonStyle}"
                                Command="{Binding NotificationFeed.ApplyFiltersCommand}"
                                AutomationProperties.Name="应用通知筛选"
                                Content="应用筛选" />
                    </StackPanel>
                </Grid>

                <WrapPanel Grid.Row="1"
                           Margin="0,12,0,0">
                    <StackPanel Width="170"
                                Margin="0,0,10,0">
                        <TextBlock Margin="2,0,0,5"
                                   Style="{StaticResource MetaTextStyle}"
                                   Text="分类" />
                        <ComboBox MinHeight="36"
                                  Style="{StaticResource CompactComboBoxStyle}"
                                  ItemsSource="{Binding NotificationFeed.Categories}"
                                  SelectedItem="{Binding NotificationFeed.SelectedCategory}"
                                  DisplayMemberPath="Label"
                                  AutomationProperties.Name="通知分类筛选" />
                    </StackPanel>
                    <StackPanel Width="190"
                                Margin="0,0,10,0">
                        <TextBlock Margin="2,0,0,5"
                                   Style="{StaticResource MetaTextStyle}"
                                   Text="Feed" />
                        <ComboBox MinHeight="36"
                                  Style="{StaticResource CompactComboBoxStyle}"
                                  ItemsSource="{Binding NotificationFeed.Feeds}"
                                  SelectedItem="{Binding NotificationFeed.SelectedFeed}"
                                  DisplayMemberPath="Label"
                                  AutomationProperties.Name="通知来源筛选" />
                    </StackPanel>
                    <StackPanel Width="150"
                                Margin="0,0,10,0">
                        <TextBlock Margin="2,0,0,5"
                                   Style="{StaticResource MetaTextStyle}"
                                   Text="发布日期" />
                        <DatePicker MinHeight="36"
                                    Style="{StaticResource CompactDatePickerStyle}"
                                    SelectedDate="{Binding NotificationFeed.SelectedDate}"
                                    AutomationProperties.Name="通知日期筛选" />
                    </StackPanel>
                    <CheckBox MinHeight="36"
                              Margin="4,19,0,0"
                              VerticalContentAlignment="Center"
                              Style="{StaticResource CompactCheckBoxStyle}"
                              IsChecked="{Binding NotificationFeed.FavoritesOnly}"
                              Content="仅看收藏"
                              AutomationProperties.Name="仅看收藏通知" />
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <controls:PagedListBox
                ItemsSource="{Binding NotificationFeed.Items}"
                SelectedItem="{Binding NotificationFeed.SelectedItem, Mode=TwoWay}"
                LoadMoreCommand="{Binding NotificationFeed.LoadMoreCommand}"
                Background="Transparent"
                BorderThickness="0"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.CanContentScroll="True"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.VirtualizationMode="Recycling"
                AutomationProperties.Name="虚拟化通知列表">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment"
                                Value="Stretch" />
                        <Setter Property="Padding"
                                Value="0" />
                        <Setter Property="Margin"
                                Value="0,0,0,10" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Button Padding="0"
                                HorizontalContentAlignment="Stretch"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding DataContext.NotificationFeed.OpenItemCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                CommandParameter="{Binding}"
                                AutomationProperties.Name="{Binding Title, StringFormat=打开通知条目：{0}}">
                            <Button.InputBindings>
                                <KeyBinding Key="Enter"
                                            Command="{Binding DataContext.NotificationFeed.OpenItemCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}" />
                            </Button.InputBindings>
                            <Border Padding="16,14"
                                    Style="{StaticResource BentoCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="38"
                                            Height="38"
                                            CornerRadius="19"
                                            Background="{DynamicResource Brush.AccentSoft}">
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="17"
                                                   Foreground="{DynamicResource Brush.Accent}"
                                                   Text="!" />
                                    </Border>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock FontWeight="SemiBold"
                                                   Text="{Binding Title}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Margin="0,5,0,0"
                                                   Style="{StaticResource MetaTextStyle}"
                                                   Text="{Binding Summary}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <StackPanel Margin="0,7,0,0"
                                                    Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource MetaTextStyle}"
                                                       Text="{Binding FeedName}" />
                                            <TextBlock Margin="7,0"
                                                       Style="{StaticResource MetaTextStyle}"
                                                       Text="·" />
                                            <TextBlock Style="{StaticResource MetaTextStyle}"
                                                       Text="{Binding CategoryName}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3"
                                                Margin="12,0,0,0"
                                                HorizontalAlignment="Right">
                                        <TextBlock Style="{StaticResource MetaTextStyle}"
                                                   Text="{Binding DisplayTime, StringFormat={}{0:yyyy-MM-dd HH:mm}}" />
                                        <TextBlock Margin="0,6,0,0"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource Brush.Accent}"
                                                   Text="已收藏">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility"
                                                            Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsStarred}"
                                                                     Value="True">
                                                            <Setter Property="Visibility"
                                                                    Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </controls:PagedListBox>

            <Border Padding="24"
                    Panel.ZIndex="10"
                    Background="{DynamicResource Brush.SurfaceRaised}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="12"
                    IsHitTestVisible="False">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility"
                                Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding NotificationFeed.Items.Count}"
                                         Value="0">
                                <Setter Property="Visibility"
                                        Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock HorizontalAlignment="Center"
                               Style="{StaticResource SectionTitleStyle}"
                               Text="当前没有可显示的 Feed 通知" />
                    <TextBlock Margin="0,6,0,0"
                               HorizontalAlignment="Center"
                               Style="{StaticResource MetaTextStyle}"
                               Text="通知 Feed 由管理员内容策略分类；顶部铃铛继续显示本机应用通知。"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
