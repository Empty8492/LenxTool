<UserControl x:Class="LenxTool.App.Views.IntegrationAdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  Focusable="False">
        <Grid MinWidth="860" Margin="28,24,28,36">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel LastChildFill="False">
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitleStyle}"
                               Text="{Binding Title}" />
                    <TextBlock Margin="0,7,0,0"
                               Style="{StaticResource MetaTextStyle}"
                               Text="{Binding Subtitle}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal">
                    <Button Margin="0,0,8,0"
                            AutomationProperties.Name="刷新外部集成策略"
                            Command="{Binding RefreshCommand}"
                            Content="刷新策略" />
                    <Button Style="{StaticResource AccentButtonStyle}"
                            AutomationProperties.Name="发布外部集成策略"
                            Command="{Binding PublishCommand}"
                            Content="发布全部策略" />
                </StackPanel>
            </DockPanel>

            <Border Grid.Row="2"
                    Padding="14,10"
                    Background="{DynamicResource Brush.SurfaceMuted}"
                    CornerRadius="8">
                <DockPanel>
                    <TextBlock FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Accent}"
                               Text="{Binding Version, StringFormat=策略集 v{0}}" />
                    <TextBlock DockPanel.Dock="Right"
                               Margin="16,0,0,0"
                               AutomationProperties.LiveSetting="Polite"
                               Style="{StaticResource MetaTextStyle}"
                               Text="{Binding Status}"
                               TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <Border Grid.Row="4"
                    Style="{StaticResource BentoCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}"
                               Text="类型与精确目标主机" />
                    <TextBlock Margin="0,6,0,14"
                               Style="{StaticResource MetaTextStyle}"
                               Text="每行一个主机名；不接受协议、端口、路径、通配符、IP、localhost 或 .local。启用类型时至少填写一项。"
                               TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Policies}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox VerticalAlignment="Top"
                                              Margin="0,9,16,0"
                                              AutomationProperties.Name="{Binding Label, StringFormat=启用 {0}}"
                                              IsChecked="{Binding IsEnabled}"
                                              Content="{Binding Label}" />
                                    <TextBox Grid.Column="1"
                                             MinHeight="58"
                                             Padding="10,7"
                                             AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto"
                                             AutomationProperties.Name="{Binding Label, StringFormat={}{0} 允许主机}"
                                             Text="{Binding AllowedHostsText, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource MetaTextStyle}"
                               Text="共享策略只包含类型、开关和主机名；个人目标、凭据、连接结果与文章数据不会上传。"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
