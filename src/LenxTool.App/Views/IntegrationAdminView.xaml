<UserControl x:Class="LenxTool.App.Views.IntegrationAdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  Focusable="False">
        <Grid MinWidth="860" Margin="28,24,28,36">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel LastChildFill="False">
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitleStyle}"
                               Text="{Binding Title}" />
                    <TextBlock Margin="0,7,0,0"
                               Style="{StaticResource MetaTextStyle}"
                               Text="{Binding Subtitle}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal">
                    <Button Margin="0,0,8,0"
                            AutomationProperties.Name="刷新外部集成策略"
                            Command="{Binding RefreshCommand}"
                            Content="刷新策略" />
                    <Button Style="{StaticResource AccentButtonStyle}"
                            AutomationProperties.Name="发布外部集成策略"
                            Command="{Binding PublishCommand}"
                            Content="发布全部策略" />
                </StackPanel>
            </DockPanel>

            <Border Grid.Row="2"
                    Padding="14,10"
                    Background="{DynamicResource Brush.SurfaceMuted}"
                    CornerRadius="8">
                <DockPanel>
                    <TextBlock FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Accent}"
                               Text="{Binding Version, StringFormat=策略集 v{0}}" />
                    <TextBlock DockPanel.Dock="Right"
                               Margin="16,0,0,0"
                               AutomationProperties.LiveSetting="Polite"
                               Style="{StaticResource MetaTextStyle}"
                               Text="{Binding Status}"
                               TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <Border Grid.Row="4"
                    Style="{StaticResource BentoCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}"
                               Text="类型与精确目标主机" />
                    <TextBlock Margin="0,6,0,14"
                               Style="{StaticResource MetaTextStyle}"
                               Text="默认只允许公网 HTTPS 精确 DNS 主机。Readeck、Outline、qBittorrent、Webhook 可额外批准精确私网 DNS:端口，但仍强制 HTTPS；qBittorrent 可单独批准 localhost HTTP 端口。禁止通配符、IP 与 .local。"
                               TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Policies}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox VerticalAlignment="Top"
                                              Margin="0,9,16,0"
                                              AutomationProperties.Name="{Binding Label, StringFormat=启用 {0}}"
                                              IsChecked="{Binding IsEnabled}"
                                              Content="{Binding Label}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBox MinHeight="58"
                                                 Padding="10,7"
                                                 AcceptsReturn="True"
                                                 IsEnabled="{Binding RequiresAllowedHosts}"
                                                 VerticalScrollBarVisibility="Auto"
                                                 AutomationProperties.Name="{Binding Label, StringFormat={}{0} 允许主机}"
                                                 Text="{Binding AllowedHostsText, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Style="{StaticResource MetaTextStyle}"
                                                   Text="{Binding HostGuidance}"
                                                   TextWrapping="Wrap" />
                                        <StackPanel Margin="0,9,0,0"
                                                    Visibility="{Binding SupportsTrustedPrivateEndpoints, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock FontWeight="SemiBold"
                                                       Text="受信私网 HTTPS 目标（每行 host:port）" />
                                            <TextBox MinHeight="52"
                                                     Margin="0,5,0,0"
                                                     Padding="10,7"
                                                     AcceptsReturn="True"
                                                     VerticalScrollBarVisibility="Auto"
                                                     AutomationProperties.Name="{Binding Label, StringFormat={}{0} 受信私网 HTTPS 目标}"
                                                     Text="{Binding TrustedPrivateEndpointsText, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,9,0,0"
                                                    Visibility="{Binding SupportsResources, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock FontWeight="SemiBold"
                                                       Text="允许资源" />
                                            <TextBox MinHeight="52"
                                                     Margin="0,5,0,0"
                                                     Padding="10,7"
                                                     AcceptsReturn="True"
                                                     VerticalScrollBarVisibility="Auto"
                                                     AutomationProperties.Name="{Binding Label, StringFormat={}{0} 允许资源}"
                                                     Text="{Binding AllowedResourcesText, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Margin="0,4,0,0"
                                                       Style="{StaticResource MetaTextStyle}"
                                                       Text="{Binding ResourceGuidance}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Margin="0,9,0,0"
                                                    Visibility="{Binding SupportsLoopbackHttpPorts, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock FontWeight="SemiBold"
                                                       Text="localhost HTTP 端口" />
                                            <TextBox MinHeight="42"
                                                     Margin="0,5,0,0"
                                                     Padding="10,7"
                                                     AcceptsReturn="True"
                                                     VerticalScrollBarVisibility="Auto"
                                                     AutomationProperties.Name="qBittorrent localhost HTTP 端口"
                                                     Text="{Binding AllowedLoopbackHttpPortsText, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource MetaTextStyle}"
                               Text="共享策略只包含类型、开关、精确主机/端口与批准资源；个人 URL、路径、凭据、连接结果与文章数据不会上传。扩展字段需要 Worker 策略 schema v2。"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
