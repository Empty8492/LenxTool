<UserControl x:Class="LenxTool.App.Views.SmartViewAdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  Focusable="False">
        <Grid MinWidth="940" Margin="28,24,28,36">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel LastChildFill="False">
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitleStyle}"
                               Text="{Binding Title}" />
                    <TextBlock Margin="0,7,0,0"
                               Style="{StaticResource MetaTextStyle}"
                               Text="{Binding Subtitle}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Button DockPanel.Dock="Right"
                        AutomationProperties.Name="刷新共享智能视图"
                        Command="{Binding RefreshCommand}"
                        Content="刷新视图" />
            </DockPanel>

            <Border Grid.Row="2"
                    Padding="14,10"
                    Background="{DynamicResource Brush.SurfaceMuted}"
                    CornerRadius="8">
                <DockPanel>
                    <TextBlock FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Accent}"
                               Text="{Binding ViewSetVersion, StringFormat=视图集 v{0}}" />
                    <TextBlock DockPanel.Dock="Right"
                               Margin="16,0,0,0"
                               AutomationProperties.LiveSetting="Polite"
                               Style="{StaticResource MetaTextStyle}"
                               Text="{Binding Status}"
                               TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" MinWidth="620" />
                </Grid.ColumnDefinitions>

                <Border Padding="0" Style="{StaticResource BentoCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="60" />
                            <RowDefinition Height="500" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="18,0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SectionTitleStyle}"
                                           Text="已发布视图" />
                                <TextBlock Margin="0,3,0,0"
                                           Style="{StaticResource MetaTextStyle}"
                                           Text="{Binding SmartViews.Count, StringFormat={}{0} 个}" />
                            </StackPanel>
                            <Button DockPanel.Dock="Right"
                                    Padding="10,5"
                                    AutomationProperties.Name="新建共享智能视图"
                                    Command="{Binding BeginNewCommand}"
                                    Content="新建" />
                        </DockPanel>
                        <ListBox Grid.Row="1"
                                 AutomationProperties.Name="共享智能视图列表"
                                 ItemsSource="{Binding SmartViews}"
                                 SelectedItem="{Binding SelectedSmartView}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinWidth="250" Margin="12,9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold"
                                                       Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Margin="0,4,0,0"
                                                       Style="{StaticResource MetaTextStyle}">
                                                <Run Text="{Binding SortOrder, StringFormat=排序 {0}}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding Version, StringFormat=v{0}}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource MetaTextStyle}"
                                                   Text="{Binding IsEnabled, StringFormat=启用 {0}}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Border Grid.Row="2"
                                Margin="12"
                                Padding="12"
                                Background="{DynamicResource Brush.SurfaceMuted}"
                                CornerRadius="8">
                            <TextBlock Style="{StaticResource MetaTextStyle}"
                                       Text="普通用户只能同步启用视图；Worker 会再次校验管理员身份、版本和幂等键。"
                                       TextWrapping="Wrap" />
                        </Border>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource BentoCardStyle}">
                        <StackPanel>
                            <DockPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitleStyle}"
                                               Text="{Binding EditorTitle}" />
                                    <TextBlock Margin="0,4,0,0"
                                               Style="{StaticResource MetaTextStyle}"
                                               Text="只允许封闭筛选字段，不支持网址、正文、正则、脚本或自定义查询。"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <CheckBox DockPanel.Dock="Right"
                                          Margin="16,0,0,0"
                                          VerticalAlignment="Center"
                                          AutomationProperties.Name="启用共享智能视图"
                                          IsChecked="{Binding ViewIsEnabled}"
                                          Content="启用" />
                            </DockPanel>

                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Margin="0,0,0,6"
                                               Style="{StaticResource MetaTextStyle}"
                                               Text="视图名称" />
                                    <TextBox MaxLength="120"
                                             AutomationProperties.Name="智能视图名称"
                                             Text="{Binding ViewName, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Margin="0,0,0,6"
                                               Style="{StaticResource MetaTextStyle}"
                                               Text="排序（0～1000）" />
                                    <TextBox AutomationProperties.Name="智能视图排序"
                                             Text="{Binding SortOrder, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Margin="0,0,0,6"
                                               Style="{StaticResource MetaTextStyle}"
                                               Text="分类" />
                                    <ComboBox AutomationProperties.Name="智能视图分类"
                                              ItemsSource="{Binding CategoryChoices}"
                                              DisplayMemberPath="Label"
                                              SelectedItem="{Binding SelectedCategory}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Margin="0,0,0,6"
                                               Style="{StaticResource MetaTextStyle}"
                                               Text="Feed" />
                                    <ComboBox AutomationProperties.Name="智能视图 Feed"
                                              ItemsSource="{Binding FeedChoices}"
                                              DisplayMemberPath="Label"
                                              SelectedItem="{Binding SelectedFeed}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Margin="0,0,0,6"
                                               Style="{StaticResource MetaTextStyle}"
                                               Text="内容类型" />
                                    <ComboBox AutomationProperties.Name="智能视图内容类型"
                                              ItemsSource="{Binding ViewKindChoices}"
                                              DisplayMemberPath="Label"
                                              SelectedItem="{Binding SelectedViewKind}" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Margin="0,0,0,6"
                                               Style="{StaticResource MetaTextStyle}"
                                               Text="阅读状态" />
                                    <ComboBox AutomationProperties.Name="智能视图阅读状态"
                                              ItemsSource="{Binding ReadFilterChoices}"
                                              DisplayMemberPath="Label"
                                              SelectedItem="{Binding SelectedReadFilter}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Margin="0,0,0,6"
                                               Style="{StaticResource MetaTextStyle}"
                                               Text="最近天数（1～365，可留空）" />
                                    <TextBox AutomationProperties.Name="智能视图最近天数"
                                             Text="{Binding PublishedWithinDays, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Margin="0,0,0,6"
                                               Style="{StaticResource MetaTextStyle}"
                                               Text="本地私人状态" />
                                    <CheckBox MinHeight="36"
                                              VerticalContentAlignment="Center"
                                              AutomationProperties.Name="智能视图仅看收藏"
                                              IsChecked="{Binding FavoritesOnly}"
                                              Content="仅看本机收藏" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Margin="0,14,0,6"
                                       Style="{StaticResource MetaTextStyle}"
                                       Text="关键词（最多 200 字）" />
                            <TextBox MaxLength="200"
                                     AutomationProperties.Name="智能视图关键词"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                            <DockPanel Margin="0,18,0,0">
                                <TextBlock VerticalAlignment="Center"
                                           Style="{StaticResource MetaTextStyle}"
                                           Text="已读和收藏只决定客户端本地查询，不会写入共享定义或云端。"
                                           TextWrapping="Wrap" />
                                <StackPanel DockPanel.Dock="Right"
                                            Margin="16,0,0,0"
                                            Orientation="Horizontal">
                                    <Button MinWidth="88"
                                            AutomationProperties.Name="删除共享智能视图"
                                            Command="{Binding PrepareDeleteCommand}"
                                            Content="删除" />
                                    <Button MinWidth="118"
                                            Margin="8,0,0,0"
                                            Style="{StaticResource AccentButtonStyle}"
                                            AutomationProperties.Name="发布共享智能视图"
                                            Command="{Binding PublishCommand}"
                                            Content="{Binding PublishLabel}" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,14,0,0"
                            Padding="14"
                            Background="{DynamicResource Brush.SurfaceMuted}"
                            CornerRadius="8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDeletePending}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <TextBlock VerticalAlignment="Center"
                                       Text="确认删除当前共享智能视图？此操作会发布新的视图集版本。"
                                       TextWrapping="Wrap" />
                            <StackPanel DockPanel.Dock="Right"
                                        Margin="16,0,0,0"
                                        Orientation="Horizontal">
                                <Button Command="{Binding CancelDeleteCommand}"
                                        Content="取消" />
                                <Button Margin="8,0,0,0"
                                        AutomationProperties.Name="确认删除共享智能视图"
                                        Command="{Binding ConfirmDeleteCommand}"
                                        Content="确认删除" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
