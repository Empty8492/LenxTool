<UserControl x:Class="LenxTool.App.Views.FeedTimelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:LenxTool.App.Views">
    <TabControl Height="680"
                Margin="0,8,0,0"
                Style="{StaticResource SegmentedTabControlStyle}"
                AutomationProperties.Name="Feed 视图切换"
                SelectedIndex="{Binding SelectedFeedViewIndex, Mode=TwoWay}">
        <TabItem Header="时间线"
                 Style="{StaticResource SegmentedTabItemStyle}"
                 AutomationProperties.Name="时间线视图">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <views:FeedTimelineFiltersView />
                <views:FeedTimelineBrowserView Grid.Row="2" />
            </Grid>
        </TabItem>
        <TabItem Header="图片"
                 Style="{StaticResource SegmentedTabItemStyle}"
                 AutomationProperties.Name="图片视图">
            <views:FeedPictureView />
        </TabItem>
        <TabItem Header="音频"
                 Style="{StaticResource SegmentedTabItemStyle}"
                 AutomationProperties.Name="音频与播客视图">
            <views:FeedAudioView />
        </TabItem>
    </TabControl>
</UserControl>
