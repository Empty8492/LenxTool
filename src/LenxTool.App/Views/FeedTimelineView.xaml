<UserControl x:Class="LenxTool.App.Views.FeedTimelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:LenxTool.App.Views">
    <TabControl Height="680"
                Margin="0,8,0,0"
                SelectedIndex="{Binding SelectedFeedViewIndex, Mode=TwoWay}">
        <TabItem Header="时间线">
            <Grid Margin="0,8,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <views:FeedTimelineFiltersView />
                <views:FeedTimelineBrowserView Grid.Row="2" />
            </Grid>
        </TabItem>
        <TabItem Header="图片">
            <views:FeedPictureView Margin="0,8,0,0" />
        </TabItem>
    </TabControl>
</UserControl>
