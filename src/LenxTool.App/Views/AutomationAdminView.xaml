<UserControl x:Class="LenxTool.App.Views.AutomationAdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  Focusable="False">
        <Grid MinWidth="940" Margin="28,24,28,36">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel LastChildFill="False">
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitleStyle}"
                               Text="{Binding Title}" />
                    <TextBlock Margin="0,7,0,0"
                               Style="{StaticResource MetaTextStyle}"
                               Text="{Binding Subtitle}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Button DockPanel.Dock="Right"
                        AutomationProperties.Name="刷新自动化规则"
                        Command="{Binding RefreshCommand}"
                        Content="刷新规则" />
            </DockPanel>

            <Border Grid.Row="2"
                    Padding="14,10"
                    Background="{DynamicResource Brush.SurfaceMuted}"
                    CornerRadius="8">
                <DockPanel>
                    <TextBlock FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Accent}"
                               Text="{Binding RuleSetVersion, StringFormat=规则集 v{0}}" />
                    <TextBlock DockPanel.Dock="Right"
                               Margin="16,0,0,0"
                               AutomationProperties.LiveSetting="Polite"
                               Style="{StaticResource MetaTextStyle}"
                               Text="{Binding Status}"
                               TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" MinWidth="620" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource BentoCardStyle}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="60" />
                            <RowDefinition Height="520" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="18,0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SectionTitleStyle}"
                                           Text="已发布规则" />
                                <TextBlock Margin="0,3,0,0"
                                           Style="{StaticResource MetaTextStyle}"
                                           Text="{Binding Rules.Count, StringFormat={}{0} 条}" />
                            </StackPanel>
                            <Button DockPanel.Dock="Right"
                                    Padding="10,5"
                                    AutomationProperties.Name="新建自动化规则"
                                    Command="{Binding BeginNewRuleCommand}"
                                    Content="新建" />
                        </DockPanel>
                        <ListBox Grid.Row="1"
                                 AutomationProperties.Name="自动化规则列表"
                                 ItemsSource="{Binding Rules}"
                                 SelectedItem="{Binding SelectedRule}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinWidth="250" Margin="12,9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold"
                                                       Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Margin="0,4,0,0"
                                                       Style="{StaticResource MetaTextStyle}">
                                                <Run Text="{Binding Priority, StringFormat=优先级 {0}}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding Version, StringFormat=v{0}}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource MetaTextStyle}"
                                                   Text="{Binding IsEnabled, StringFormat=启用 {0}}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Border Grid.Row="2"
                                Margin="12"
                                Padding="12"
                                Background="{DynamicResource Brush.SurfaceMuted}"
                                CornerRadius="8">
                            <TextBlock Style="{StaticResource MetaTextStyle}"
                                       Text="普通用户看不到此入口；发布由 Worker 再次校验管理员身份并记录审计。"
                                       TextWrapping="Wrap" />
                        </Border>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource BentoCardStyle}">
                        <StackPanel>
                            <DockPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitleStyle}"
                                               Text="{Binding EditorTitle}" />
                                    <TextBlock Margin="0,4,0,0"
                                               Style="{StaticResource MetaTextStyle}"
                                               Text="仅可使用受限字段、操作符和动作，不支持脚本或自定义请求。" />
                                </StackPanel>
                                <CheckBox DockPanel.Dock="Right"
                                          Margin="16,0,0,0"
                                          VerticalAlignment="Center"
                                          AutomationProperties.Name="启用自动化规则"
                                          IsChecked="{Binding RuleIsEnabled}"
                                          Content="启用" />
                            </DockPanel>

                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="1.25*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Margin="0,0,0,6"
                                               Style="{StaticResource MetaTextStyle}"
                                               Text="规则名称" />
                                    <TextBox MaxLength="120"
                                             AutomationProperties.Name="规则名称"
                                             Text="{Binding RuleName, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Margin="0,0,0,6"
                                               Style="{StaticResource MetaTextStyle}"
                                               Text="优先级（0～1000）" />
                                    <TextBox AutomationProperties.Name="规则优先级"
                                             Text="{Binding Priority, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Margin="0,0,0,6"
                                               Style="{StaticResource MetaTextStyle}"
                                               Text="冲突顺序（0～1000）" />
                                    <TextBox AutomationProperties.Name="规则冲突顺序"
                                             Text="{Binding ConflictOrder, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="6">
                                    <TextBlock Margin="0,0,0,6"
                                               Style="{StaticResource MetaTextStyle}"
                                               Text="条件关系" />
                                    <ComboBox AutomationProperties.Name="规则条件关系"
                                              ItemsSource="{Binding MatchModeChoices}"
                                              DisplayMemberPath="Label"
                                              SelectedItem="{Binding SelectedMatchMode}" />
                                </StackPanel>
                            </Grid>

                            <DockPanel Margin="0,22,0,8">
                                <TextBlock VerticalAlignment="Center"
                                           Style="{StaticResource SectionTitleStyle}"
                                           Text="条件" />
                                <Button DockPanel.Dock="Right"
                                        Padding="10,5"
                                        AutomationProperties.Name="添加规则条件"
                                        Command="{Binding AddConditionCommand}"
                                        Content="添加条件" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Conditions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8"
                                                Padding="12"
                                                Background="{DynamicResource Brush.SurfaceMuted}"
                                                CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.1*" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="1.1*" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ComboBox AutomationProperties.Name="条件字段"
                                                          ItemsSource="{Binding DataContext.FieldChoices, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          DisplayMemberPath="Label"
                                                          SelectedItem="{Binding SelectedField}" />
                                                <ComboBox Grid.Column="2"
                                                          AutomationProperties.Name="条件操作符"
                                                          ItemsSource="{Binding OperatorChoices}"
                                                          DisplayMemberPath="Label"
                                                          SelectedItem="{Binding SelectedOperator}" />
                                                <Grid Grid.Column="4">
                                                    <TextBox AutomationProperties.Name="条件值"
                                                             ToolTip="{Binding ValueHint}"
                                                             Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}">
                                                        <TextBox.Style>
                                                            <Style TargetType="TextBox">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding RequiresValue}" Value="False">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsBooleanValue}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBox.Style>
                                                    </TextBox>
                                                    <ComboBox AutomationProperties.Name="布尔条件值"
                                                              ItemsSource="{Binding DataContext.BooleanChoices, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              SelectedItem="{Binding Value}">
                                                        <ComboBox.Style>
                                                            <Style TargetType="ComboBox">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding IsBooleanValue}" Value="True" />
                                                                            <Condition Binding="{Binding RequiresValue}" Value="True" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ComboBox.Style>
                                                    </ComboBox>
                                                    <TextBlock VerticalAlignment="Center"
                                                               Text="{Binding ValueHint}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock"
                                                                   BasedOn="{StaticResource MetaTextStyle}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding RequiresValue}" Value="False">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                                <Button Grid.Column="6"
                                                        Padding="10,5"
                                                        AutomationProperties.Name="删除规则条件"
                                                        Command="{Binding DataContext.RemoveConditionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Content="删除" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <DockPanel Margin="0,14,0,8">
                                <TextBlock VerticalAlignment="Center"
                                           Style="{StaticResource SectionTitleStyle}"
                                           Text="动作" />
                                <Button DockPanel.Dock="Right"
                                        Padding="10,5"
                                        AutomationProperties.Name="添加规则动作"
                                        Command="{Binding AddActionCommand}"
                                        Content="添加动作" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Actions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8"
                                                Padding="12"
                                                Background="{DynamicResource Brush.SurfaceMuted}"
                                                CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.2*" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ComboBox AutomationProperties.Name="规则动作"
                                                          ItemsSource="{Binding DataContext.ActionChoices, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          DisplayMemberPath="Label"
                                                          SelectedItem="{Binding SelectedType}" />
                                                <Grid Grid.Column="2">
                                                    <TextBox AutomationProperties.Name="动作值"
                                                             ToolTip="{Binding ValueHint}"
                                                             Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}">
                                                        <TextBox.Style>
                                                            <Style TargetType="TextBox">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding RequiresValue}" Value="True" />
                                                                            <Condition Binding="{Binding IsTranslation}" Value="False" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBox.Style>
                                                    </TextBox>
                                                    <ComboBox AutomationProperties.Name="翻译目标语言"
                                                              ItemsSource="{Binding DataContext.TranslationLanguageChoices, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              DisplayMemberPath="Label"
                                                              SelectedValuePath="Value"
                                                              SelectedValue="{Binding Value}">
                                                        <ComboBox.Style>
                                                            <Style TargetType="ComboBox">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsTranslation}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ComboBox.Style>
                                                    </ComboBox>
                                                    <TextBlock VerticalAlignment="Center"
                                                               Text="{Binding ValueHint}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock"
                                                                   BasedOn="{StaticResource MetaTextStyle}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding RequiresValue}" Value="False">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                                <Button Grid.Column="4"
                                                        Padding="10,5"
                                                        AutomationProperties.Name="删除规则动作"
                                                        Command="{Binding DataContext.RemoveActionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Content="删除" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <DockPanel Margin="0,18,0,0">
                                <TextBlock VerticalAlignment="Center"
                                           Style="{StaticResource MetaTextStyle}"
                                           Text="模拟只读：不写运行账本、动作队列或通知收件箱。"
                                           TextWrapping="Wrap" />
                                <StackPanel DockPanel.Dock="Right"
                                            Margin="16,0,0,0"
                                            Orientation="Horizontal">
                                    <Button MinWidth="108"
                                            AutomationProperties.Name="只读模拟规则"
                                            Command="{Binding SimulateCommand}"
                                            Content="只读模拟" />
                                    <Button MinWidth="118"
                                            Margin="8,0,0,0"
                                            Style="{StaticResource AccentButtonStyle}"
                                            AutomationProperties.Name="发布自动化规则"
                                            Command="{Binding PublishCommand}"
                                            Content="{Binding PublishLabel}" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,14,0,0"
                            Style="{StaticResource BentoCardStyle}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Style="{StaticResource SectionTitleStyle}"
                                           Text="最近条目模拟结果" />
                                <TextBlock DockPanel.Dock="Right"
                                           Style="{StaticResource MetaTextStyle}"
                                           Text="{Binding SimulationEntries.Count, StringFormat={}{0} 条}" />
                            </DockPanel>
                            <TextBlock Margin="0,7,0,12"
                                       Style="{StaticResource MetaTextStyle}"
                                       Text="结果仅展示规则判断和计划动作，不会调用 AI、投递媒体或发送通知。"
                                       TextWrapping="Wrap" />
                            <ItemsControl AutomationProperties.Name="规则模拟结果"
                                          ItemsSource="{Binding SimulationEntries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8"
                                                Padding="12"
                                                BorderBrush="{DynamicResource Brush.Border}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold"
                                                               Text="{Binding Title}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               Style="{StaticResource MetaTextStyle}">
                                                        <Run Text="{Binding SourceLabel}" />
                                                        <Run Text=" · " />
                                                        <Run Text="{Binding PublishedText}" />
                                                    </TextBlock>
                                                    <TextBlock Margin="0,5,0,0"
                                                               Style="{StaticResource MetaTextStyle}"
                                                               Text="{Binding ActionsLabel}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                                <Border Grid.Column="1"
                                                        Margin="12,0,0,0"
                                                        Padding="9,4"
                                                        VerticalAlignment="Top"
                                                        Background="{DynamicResource Brush.SurfaceMuted}"
                                                        CornerRadius="10">
                                                    <TextBlock FontWeight="SemiBold"
                                                               Text="{Binding OutcomeLabel}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground"
                                                                        Value="{DynamicResource Brush.TextSecondary}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMatched}" Value="True">
                                                                        <Setter Property="Foreground"
                                                                                Value="{DynamicResource Brush.Accent}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
